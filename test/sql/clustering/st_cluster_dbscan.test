# name: test/sql/clustering/st_cluster_dbscan.test
# group: [clustering]

require spatial

# ===========================================================================
# Basic: 3 clusters + 2 noise points
# ===========================================================================

statement ok
CREATE TABLE pts AS SELECT * FROM (VALUES
    (ST_Point(0, 0), 'a1'), (ST_Point(1, 0), 'a2'), (ST_Point(0, 1), 'a3'), (ST_Point(1, 1), 'a4'),
    (ST_Point(10, 10), 'b1'), (ST_Point(11, 10), 'b2'), (ST_Point(10, 11), 'b3'),
    (ST_Point(20, 20), 'c1'), (ST_Point(21, 20), 'c2'), (ST_Point(20, 21), 'c3'),
    (ST_Point(50, 50), 'noise1'), (ST_Point(80, 80), 'noise2')
) t(geom, name);

# 3 clusters, 2 noise
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NOT NULL;
----
3

# Noise points are NULL
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NULL;
----
2

# Total rows preserved
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
);
----
12

# Cluster a has 4 members
query I
SELECT count(*) FROM (
    SELECT name, ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE name LIKE 'a%' AND cluster_id IS NOT NULL;
----
4

# All a-points in same cluster
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT name, ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE name LIKE 'a%';
----
1

# ===========================================================================
# All same cluster (eps large enough)
# ===========================================================================

query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 100.0, 2) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NOT NULL;
----
1

# ===========================================================================
# All noise (minpoints too high)
# ===========================================================================

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 100) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NULL;
----
12

# ===========================================================================
# All noise (eps too small)
# ===========================================================================

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 0.01, 2) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NULL;
----
12

# ===========================================================================
# Single point
# ===========================================================================

statement ok
CREATE TABLE one_pt AS SELECT ST_Point(0, 0) as geom;

query I
SELECT ST_ClusterDBSCAN(geom, 1.0, 1) OVER () FROM one_pt;
----
0

query I
SELECT ST_ClusterDBSCAN(geom, 1.0, 2) OVER () FROM one_pt;
----
NULL

# ===========================================================================
# NULL geometries
# ===========================================================================

statement ok
CREATE TABLE with_nulls AS SELECT * FROM (VALUES
    (ST_Point(0, 0)), (NULL::GEOMETRY), (ST_Point(1, 0)), (NULL::GEOMETRY), (ST_Point(0, 1))
) t(geom);

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 2) OVER () as cid FROM with_nulls
) WHERE cid IS NULL;
----
2

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 2) OVER () as cid FROM with_nulls
) WHERE cid IS NOT NULL;
----
3

# ===========================================================================
# Error handling
# ===========================================================================

statement error
SELECT ST_ClusterDBSCAN(geom, -1.0, 3) OVER () FROM pts;
----
eps must be >= 0

# ===========================================================================
# ST_ClusterKMeans
# ===========================================================================

statement ok
CREATE TABLE km_pts AS SELECT * FROM (VALUES
    (ST_Point(0, 0), 'a1'), (ST_Point(1, 0), 'a2'), (ST_Point(0, 1), 'a3'),
    (ST_Point(10, 10), 'b1'), (ST_Point(11, 10), 'b2'), (ST_Point(10, 11), 'b3'),
    (ST_Point(20, 20), 'c1'), (ST_Point(21, 20), 'c2'), (ST_Point(20, 21), 'c3')
) t(geom, name);

# k=3 should find 3 clusters
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () as cluster_id FROM km_pts
);
----
3

# k=1 puts everything in one cluster
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterKMeans(geom, 1) OVER () as cluster_id FROM km_pts
);
----
1

# All 9 rows get a cluster ID
query I
SELECT count(*) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () as cid FROM km_pts
) WHERE cid IS NOT NULL;
----
9

# Error on k < 1
statement error
SELECT ST_ClusterKMeans(geom, 0) OVER () FROM km_pts;
----
k must be >= 1

statement error
SELECT ST_ClusterDBSCAN(geom, 1.0, 0) OVER () FROM pts;
----
minpoints must be >= 1

# ===========================================================================
# Larger dataset: 2 well-separated clusters of 50 points each
# ===========================================================================

statement ok
CREATE TABLE big AS SELECT * FROM (
    SELECT ST_Point(random() * 2, random() * 2) as geom, x as id FROM generate_series(1, 50) r(x)
    UNION ALL
    SELECT ST_Point(100 + random() * 2, 100 + random() * 2) as geom, x + 50 as id FROM generate_series(1, 50) r(x)
);

# 2 clusters, 0 noise (eps=5 covers each 2x2 box, minpoints=5)
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 5) OVER () as cluster_id FROM big
) WHERE cluster_id IS NOT NULL;
----
2

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 5) OVER () as cluster_id FROM big
) WHERE cluster_id IS NULL;
----
0

# =====================================================================
# > STANDARD_VECTOR_SIZE partition — exercises multi-chunk window output
# STANDARD_VECTOR_SIZE is 2048, so 3000 rows forces a second chunk and
# catches window callback indexing bugs across chunk boundaries.
# =====================================================================

statement ok
CREATE TABLE multi_chunk AS
SELECT ST_Point(
    -- 3 tight clusters, 1000 points each
    CASE WHEN i < 1000 THEN i * 0.0001
         WHEN i < 2000 THEN 100 + (i - 1000) * 0.0001
         ELSE 200 + (i - 2000) * 0.0001
    END,
    CASE WHEN i < 1000 THEN i * 0.0001
         WHEN i < 2000 THEN 100 + (i - 1000) * 0.0001
         ELSE 200 + (i - 2000) * 0.0001
    END
) AS geom, i AS id
FROM generate_series(0, 2999) t(i);

# DBSCAN across chunk boundary: must still find exactly 3 clusters
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 1.0, 5) OVER () AS cluster_id FROM multi_chunk
) WHERE cluster_id IS NOT NULL;
----
3

# Every row must be assigned (no NULLs — all points are in dense clusters)
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 1.0, 5) OVER () AS cluster_id FROM multi_chunk
) WHERE cluster_id IS NULL;
----
0

# Total row count preserved across chunks
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 1.0, 5) OVER () AS cluster_id FROM multi_chunk
);
----
3000

# KMeans across chunk boundary: 3 clusters should separate the 3 tight groups
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () AS cluster_id FROM multi_chunk
);
----
3

# KMeans assigns every row
query I
SELECT count(*) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () AS cluster_id FROM multi_chunk
) WHERE cluster_id IS NULL;
----
0
