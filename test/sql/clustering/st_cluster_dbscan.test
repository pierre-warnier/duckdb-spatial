# name: test/sql/clustering/st_cluster_dbscan.test
# group: [clustering]

require spatial

# ===========================================================================
# Basic: 3 clusters + 2 noise points
# ===========================================================================

statement ok
CREATE TABLE pts AS SELECT * FROM (VALUES
    (ST_Point(0, 0), 'a1'), (ST_Point(1, 0), 'a2'), (ST_Point(0, 1), 'a3'), (ST_Point(1, 1), 'a4'),
    (ST_Point(10, 10), 'b1'), (ST_Point(11, 10), 'b2'), (ST_Point(10, 11), 'b3'),
    (ST_Point(20, 20), 'c1'), (ST_Point(21, 20), 'c2'), (ST_Point(20, 21), 'c3'),
    (ST_Point(50, 50), 'noise1'), (ST_Point(80, 80), 'noise2')
) t(geom, name);

# 3 clusters, 2 noise
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NOT NULL;
----
3

# Noise points are NULL
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NULL;
----
2

# Total rows preserved
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
);
----
12

# Cluster a has 4 members
query I
SELECT count(*) FROM (
    SELECT name, ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE name LIKE 'a%' AND cluster_id IS NOT NULL;
----
4

# All a-points in same cluster
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT name, ST_ClusterDBSCAN(geom, 2.0, 3) OVER () as cluster_id FROM pts
) WHERE name LIKE 'a%';
----
1

# ===========================================================================
# All same cluster (eps large enough)
# ===========================================================================

query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 100.0, 2) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NOT NULL;
----
1

# ===========================================================================
# All noise (minpoints too high)
# ===========================================================================

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 2.0, 100) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NULL;
----
12

# ===========================================================================
# All noise (eps too small)
# ===========================================================================

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 0.01, 2) OVER () as cluster_id FROM pts
) WHERE cluster_id IS NULL;
----
12

# ===========================================================================
# Single point
# ===========================================================================

statement ok
CREATE TABLE one_pt AS SELECT ST_Point(0, 0) as geom;

query I
SELECT ST_ClusterDBSCAN(geom, 1.0, 1) OVER () FROM one_pt;
----
0

query I
SELECT ST_ClusterDBSCAN(geom, 1.0, 2) OVER () FROM one_pt;
----
NULL

# ===========================================================================
# NULL geometries
# ===========================================================================

statement ok
CREATE TABLE with_nulls AS SELECT * FROM (VALUES
    (ST_Point(0, 0)), (NULL::GEOMETRY), (ST_Point(1, 0)), (NULL::GEOMETRY), (ST_Point(0, 1))
) t(geom);

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 2) OVER () as cid FROM with_nulls
) WHERE cid IS NULL;
----
2

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 2) OVER () as cid FROM with_nulls
) WHERE cid IS NOT NULL;
----
3

# ===========================================================================
# Error handling
# ===========================================================================

statement error
SELECT ST_ClusterDBSCAN(geom, -1.0, 3) OVER () FROM pts;
----
eps must be >= 0

# ===========================================================================
# ST_ClusterKMeans
# ===========================================================================

statement ok
CREATE TABLE km_pts AS SELECT * FROM (VALUES
    (ST_Point(0, 0), 'a1'), (ST_Point(1, 0), 'a2'), (ST_Point(0, 1), 'a3'),
    (ST_Point(10, 10), 'b1'), (ST_Point(11, 10), 'b2'), (ST_Point(10, 11), 'b3'),
    (ST_Point(20, 20), 'c1'), (ST_Point(21, 20), 'c2'), (ST_Point(20, 21), 'c3')
) t(geom, name);

# k=3 should find 3 clusters
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () as cluster_id FROM km_pts
);
----
3

# k=1 puts everything in one cluster
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterKMeans(geom, 1) OVER () as cluster_id FROM km_pts
);
----
1

# All 9 rows get a cluster ID
query I
SELECT count(*) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () as cid FROM km_pts
) WHERE cid IS NOT NULL;
----
9

# Error on k < 1
statement error
SELECT ST_ClusterKMeans(geom, 0) OVER () FROM km_pts;
----
k must be >= 1

statement error
SELECT ST_ClusterDBSCAN(geom, 1.0, 0) OVER () FROM pts;
----
minpoints must be >= 1

# ===========================================================================
# Larger dataset: 2 well-separated clusters of 50 points each
# ===========================================================================

statement ok
CREATE TABLE big AS SELECT * FROM (
    SELECT ST_Point(random() * 2, random() * 2) as geom, x as id FROM generate_series(1, 50) r(x)
    UNION ALL
    SELECT ST_Point(100 + random() * 2, 100 + random() * 2) as geom, x + 50 as id FROM generate_series(1, 50) r(x)
);

# 2 clusters, 0 noise (eps=5 covers each 2x2 box, minpoints=5)
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 5) OVER () as cluster_id FROM big
) WHERE cluster_id IS NOT NULL;
----
2

query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 5.0, 5) OVER () as cluster_id FROM big
) WHERE cluster_id IS NULL;
----
0

# =====================================================================
# > STANDARD_VECTOR_SIZE partition — exercises multi-chunk window output
# STANDARD_VECTOR_SIZE is 2048, so 3000 rows forces a second chunk and
# catches window callback indexing bugs across chunk boundaries.
# =====================================================================

statement ok
CREATE TABLE multi_chunk AS
SELECT ST_Point(
    -- 3 tight clusters, 1000 points each
    CASE WHEN i < 1000 THEN i * 0.0001
         WHEN i < 2000 THEN 100 + (i - 1000) * 0.0001
         ELSE 200 + (i - 2000) * 0.0001
    END,
    CASE WHEN i < 1000 THEN i * 0.0001
         WHEN i < 2000 THEN 100 + (i - 1000) * 0.0001
         ELSE 200 + (i - 2000) * 0.0001
    END
) AS geom, i AS id
FROM generate_series(0, 2999) t(i);

# DBSCAN across chunk boundary: must still find exactly 3 clusters
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterDBSCAN(geom, 1.0, 5) OVER () AS cluster_id FROM multi_chunk
) WHERE cluster_id IS NOT NULL;
----
3

# Every row must be assigned (no NULLs — all points are in dense clusters)
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 1.0, 5) OVER () AS cluster_id FROM multi_chunk
) WHERE cluster_id IS NULL;
----
0

# Total row count preserved across chunks
query I
SELECT count(*) FROM (
    SELECT ST_ClusterDBSCAN(geom, 1.0, 5) OVER () AS cluster_id FROM multi_chunk
);
----
3000

# KMeans across chunk boundary: 3 clusters should separate the 3 tight groups
query I
SELECT count(DISTINCT cluster_id) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () AS cluster_id FROM multi_chunk
);
----
3

# KMeans assigns every row
query I
SELECT count(*) FROM (
    SELECT ST_ClusterKMeans(geom, 3) OVER () AS cluster_id FROM multi_chunk
) WHERE cluster_id IS NULL;
----
0

# =====================================================================
# OVER (PARTITION BY ... ORDER BY ...)
#
# The whole partition is clustered whatever the ORDER BY and frame of the
# window. PARTITION BY without ORDER BY is covered further down.
# =====================================================================

statement ok
CREATE TABLE ordered AS
SELECT 'a' AS grp, ST_Point(i * 0.1, 0.0) AS geom, i AS id FROM generate_series(0, 9) t(i)
UNION ALL
SELECT 'a' AS grp, ST_Point(10 + i * 0.1, 0.0) AS geom, i + 10 AS id FROM generate_series(0, 9) t(i)
UNION ALL
SELECT 'b' AS grp, ST_Point(100 + i * 0.1, 0.0) AS geom, i + 20 AS id FROM generate_series(0, 9) t(i)
UNION ALL
SELECT 'b' AS grp, ST_Point(200 + i * 0.1, 0.0) AS geom, i + 30 AS id FROM generate_series(0, 9) t(i);

# Each partition is clustered independently. Group 'a' has 2 clusters,
# group 'b' has 2 clusters — the l_state counter must reset between
# partitions otherwise 'b' reads stale ids from 'a'.
query II
SELECT grp, count(DISTINCT cid) FROM (
    SELECT grp, ST_ClusterDBSCAN(geom, 1.0, 2) OVER (PARTITION BY grp ORDER BY id) AS cid FROM ordered
) WHERE cid IS NOT NULL
GROUP BY grp
ORDER BY grp;
----
a	2
b	2

query II
SELECT grp, count(DISTINCT cid) FROM (
    SELECT grp, ST_ClusterKMeans(geom, 2) OVER (PARTITION BY grp ORDER BY id) AS cid FROM ordered
)
GROUP BY grp
ORDER BY grp;
----
a	2
b	2

# ---------------------------------------------------------------------------
# Every row gets the cluster of its own geometry, whatever the number of
# threads and the size of the partition
# ---------------------------------------------------------------------------

statement ok
SET threads = 8;

# Isolated points, each a cluster of its own: the cluster id must follow the row
query IIIII
WITH t AS (SELECT i, ST_Point(i * 10.0 + (i % 2), 0) AS g FROM range(100000) x(i)),
     c AS (SELECT i, ST_ClusterDBSCAN(g, 1.0, 1) OVER () AS c FROM t)
SELECT count(DISTINCT c), count(*), min(c), max(c), count(*) FILTER (WHERE c <> i) FROM c;
----
100000	100000	0	99999	0

# Two points of every cluster are 1 apart, the clusters are 100 apart: rows of the same pair share a cluster
query II
WITH t AS (SELECT i, ST_Point((i // 2) * 100.0 + (i % 2), 0) AS g FROM range(60000) x(i)),
     c AS (SELECT i, ST_ClusterDBSCAN(g, 1.5, 2) OVER () AS c FROM t)
SELECT count(DISTINCT c), count(*) FROM (SELECT i // 2 AS pair, min(c) AS c FROM c GROUP BY 1 HAVING count(DISTINCT c) = 1);
----
30000	30000

# Noise stays on the rows it belongs to
query II
WITH t AS (SELECT i, CASE WHEN i % 10 = 0 THEN ST_Point(-1000.0 - i * 50, 500) ELSE ST_Point((i % 10) * 0.1, 0) END AS g FROM range(50000) x(i)),
     c AS (SELECT i, ST_ClusterDBSCAN(g, 0.5, 3) OVER () AS c FROM t)
SELECT count(*) FILTER (WHERE (c IS NULL) <> (i % 10 = 0)), count(DISTINCT c) FROM c;
----
0	1

# PARTITION BY without ORDER BY, several large partitions
query IIII
WITH t AS (SELECT i % 3 AS grp, i, ST_Point((i % 1000) * 1.0, (i // 1000) % 7 * 100.0) AS g FROM range(300000) x(i)),
     c AS (SELECT grp, i, ST_ClusterDBSCAN(g, 1.5, 2) OVER (PARTITION BY grp) AS c FROM t)
SELECT grp, count(DISTINCT c), count(*) FILTER (WHERE c IS NULL), count(*) FROM c GROUP BY 1 ORDER BY 1;
----
0	7	0	100000
1	7	0	100000
2	7	0	100000

# The frame clause of the window does not change the result
query I
WITH t AS (SELECT i, ST_Point((i // 2) * 100.0 + (i % 2), 0) AS g FROM range(10000) x(i))
SELECT count(*) FROM (
	SELECT ST_ClusterDBSCAN(g, 1.5, 2) OVER () AS a,
	       ST_ClusterDBSCAN(g, 1.5, 2) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS b
	FROM t) WHERE a IS DISTINCT FROM b;
----
0

# K-means: two well separated groups, large partition
query III
WITH t AS (SELECT i, ST_Point(CASE WHEN i % 2 = 0 THEN 0 ELSE 1000 END + (i % 97) * 0.01, (i % 89) * 0.01) AS g FROM range(100000) x(i)),
     c AS (SELECT i, ST_ClusterKMeans(g, 2) OVER () AS c FROM t)
SELECT i % 2, count(DISTINCT c), count(*) FROM c GROUP BY 1 ORDER BY 1;
----
0	1	50000
1	1	50000

query I
WITH t AS (SELECT i, ST_Point(CASE WHEN i % 2 = 0 THEN 0 ELSE 1000 END + (i % 97) * 0.01, (i % 89) * 0.01) AS g FROM range(100000) x(i)),
     c AS (SELECT i, ST_ClusterKMeans(g, 2) OVER (PARTITION BY i % 4 >= 2) AS c FROM t)
SELECT count(*) FROM (SELECT i % 4 >= 2 AS grp, i % 2 AS side, count(DISTINCT c) AS n FROM c GROUP BY 1, 2) WHERE n = 1;
----
4
