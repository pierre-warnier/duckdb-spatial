# name: test/sql/raster/raster_constructors.test
# group: [raster]

require spatial

# ST_MakeEmptyRaster
query I
SELECT ST_MetaData(ST_MakeEmptyRaster(10, 5, 100, 200, 2, -3, 0.5, 0.25, 4326))::VARCHAR;
----
{'upperleftx': 100.0, 'upperlefty': 200.0, 'width': 10, 'height': 5, 'scalex': 2.0, 'scaley': -3.0, 'skewx': 0.5, 'skewy': 0.25, 'srid': 4326, 'numbands': 0}

query I
SELECT ST_MetaData(ST_MakeEmptyRaster(10, 5, 100, 200, 2, -3, 0, 0))::VARCHAR;
----
{'upperleftx': 100.0, 'upperlefty': 200.0, 'width': 10, 'height': 5, 'scalex': 2.0, 'scaley': -3.0, 'skewx': 0.0, 'skewy': 0.0, 'srid': 0, 'numbands': 0}

query I
SELECT ST_MetaData(ST_MakeEmptyRaster(10, 5, 100, 200, 0.5))::VARCHAR;
----
{'upperleftx': 100.0, 'upperlefty': 200.0, 'width': 10, 'height': 5, 'scalex': 0.5, 'scaley': -0.5, 'skewx': 0.0, 'skewy': 0.0, 'srid': 0, 'numbands': 0}

# The identity georeference round-trips too
query I
SELECT ST_MetaData(ST_MakeEmptyRaster(3, 3, 0, 0, 1, 1, 0, 0))::VARCHAR;
----
{'upperleftx': 0.0, 'upperlefty': 0.0, 'width': 3, 'height': 3, 'scalex': 1.0, 'scaley': 1.0, 'skewx': 0.0, 'skewy': 0.0, 'srid': 0, 'numbands': 0}

# From another raster: same grid and coordinate system, no bands
query I
SELECT ST_MetaData(ST_MakeEmptyRaster(ST_AddBand(ST_MakeEmptyRaster(10, 5, 100, 200, 2, -3, 0, 0, 3857), '8BUI')))::VARCHAR;
----
{'upperleftx': 100.0, 'upperlefty': 200.0, 'width': 10, 'height': 5, 'scalex': 2.0, 'scaley': -3.0, 'skewx': 0.0, 'skewy': 0.0, 'srid': 3857, 'numbands': 0}

statement error
SELECT ST_MakeEmptyRaster(0, 5, 0, 0, 1);
----
width and height must be positive

statement error
SELECT ST_MakeEmptyRaster(5, -1, 0, 0, 1);
----
width and height must be positive

statement error
SELECT ST_MakeEmptyRaster(5, 5, 0, 0, 1, -1, 0, 0, 999999);
----
EPSG:999999

# ST_AddBand: every pixel type, with initial value and NODATA
query III
SELECT pixeltype, ST_BandPixelType(r), ST_Value(r, 1, 1)::INTEGER
FROM (SELECT pixeltype, ST_AddBand(ST_MakeEmptyRaster(2, 2, 0, 0, 1), pixeltype, 5) AS r
      FROM (VALUES ('8BUI'), ('8BSI'), ('16BUI'), ('16BSI'), ('32BUI'), ('32BSI'), ('32BF'), ('64BF'), ('1BB'), ('2BUI'), ('4BUI'), ('8bui')) t(pixeltype))
ORDER BY pixeltype;
----
16BSI	16BSI	5
16BUI	16BUI	5
1BB	8BUI	5
2BUI	8BUI	5
32BF	32BF	5
32BSI	32BSI	5
32BUI	32BUI	5
4BUI	8BUI	5
64BF	64BF	5
8BSI	8BSI	5
8BUI	8BUI	5
8bui	8BUI	5

statement error
SELECT ST_AddBand(ST_MakeEmptyRaster(2, 2, 0, 0, 1), '12BUI');
----
Unknown pixel type '12BUI'

# Defaults: filled with 0, no NODATA
query III
SELECT ST_NumBands(r), ST_Value(r, 2, 2)::INTEGER, ST_BandNoDataValue(r) IS NULL FROM (SELECT ST_AddBand(ST_MakeEmptyRaster(2, 2, 0, 0, 1), '32BF') AS r);
----
1	0	true

# A literal NULL NODATA value does not make the result NULL
query III
SELECT ST_NumBands(r), abs(ST_Value(r, 1, 1) - 1.5) < 1e-12, ST_BandNoDataValue(r) IS NULL FROM (SELECT ST_AddBand(ST_MakeEmptyRaster(2, 2, 0, 0, 1), '64BF', 1.5, NULL) AS r);
----
1	true	true

# Values are clamped to the pixel type
query II
SELECT ST_Value(ST_AddBand(ST_MakeEmptyRaster(2, 2, 0, 0, 1), '8BUI', 300), 1, 1)::INTEGER, ST_Value(ST_AddBand(ST_MakeEmptyRaster(2, 2, 0, 0, 1), '8BUI', -4), 1, 1)::INTEGER;
----
255	0

# Per-band NODATA values are independent
statement ok
CREATE TABLE multi AS SELECT ST_AddBand(ST_AddBand(ST_AddBand(ST_MakeEmptyRaster(3, 2, 0, 0, 1), '16BSI', 1, -1), '16BSI', 2), '16BSI', 3, -3) AS rast;

query IIIIII
SELECT ST_NumBands(rast), ST_BandNoDataValue(rast, 1)::INTEGER, ST_BandNoDataValue(rast, 2) IS NULL, ST_BandNoDataValue(rast, 3)::INTEGER, ST_Value(rast, 2, 1, 1)::INTEGER, ST_Value(rast, 3, 3, 2)::INTEGER FROM multi;
----
3	-1	true	-3	2	3

# All bands share one pixel type
statement error
SELECT ST_AddBand(rast, '32BF') FROM multi;
----
All bands of a RASTER share one pixel type

# Insert at an index
query IIII
SELECT ST_NumBands(r), ST_Value(r, 1, 1, 1)::INTEGER, ST_Value(r, 2, 1, 1)::INTEGER, ST_Value(r, 4, 1, 1)::INTEGER FROM (SELECT ST_AddBand(rast, 2, '16BSI', 9) AS r FROM multi);
----
4	1	9	3

query II
SELECT ST_NumBands(r), ST_Value(r, 4, 1, 1)::INTEGER FROM (SELECT ST_AddBand(rast, 10, '16BSI', 9, -9) AS r FROM multi);
----
4	9

statement error
SELECT ST_AddBand(rast, 0, '16BSI') FROM multi;
----
Band index must be at least 1

# From another raster
query IIII
SELECT ST_NumBands(r), ST_Value(r, 4, 1, 1)::INTEGER, ST_BandNoDataValue(r, 4)::INTEGER, ST_Value(r, 3, 1, 1)::INTEGER FROM (SELECT ST_AddBand(rast, rast, 3) AS r FROM multi);
----
4	3	-3	3

query III
SELECT ST_NumBands(r), ST_Value(r, 1, 1, 1)::INTEGER, ST_Value(r, 2, 1, 1)::INTEGER FROM (SELECT ST_AddBand(rast, rast, 2, 1) AS r FROM multi);
----
4	2	1

query I
SELECT ST_NumBands(ST_AddBand(rast, rast)) FROM multi;
----
4

# From a list of rasters
query IIII
SELECT ST_NumBands(r), ST_Value(r, 1, 1, 1)::INTEGER, ST_Value(r, 2, 1, 1)::INTEGER, ST_Value(r, 3, 1, 1)::INTEGER FROM (SELECT ST_AddBand(ST_MakeEmptyRaster(rast), [rast, rast, rast], 3) AS r FROM multi);
----
3	3	3	3

query II
SELECT ST_NumBands(r), ST_Value(r, 1, 1, 1)::INTEGER FROM (SELECT ST_AddBand(rast, [rast], 2, 1) AS r FROM multi);
----
4	2

statement error
SELECT ST_AddBand(rast, ST_AddBand(ST_MakeEmptyRaster(2, 2, 0, 0, 1), '16BSI')) FROM multi;
----
same width and height

statement error
SELECT ST_AddBand(rast, rast, 7) FROM multi;
----
Band 7 is out of range

# ST_Band
query II
SELECT ST_NumBands(ST_Band(rast)), ST_Value(ST_Band(rast), 1, 1)::INTEGER FROM multi;
----
1	1

query II
SELECT ST_NumBands(ST_Band(rast, 3)), ST_Value(ST_Band(rast, 3), 1, 1)::INTEGER FROM multi;
----
1	3

query IIII
SELECT ST_NumBands(r), ST_Value(r, 1, 1, 1)::INTEGER, ST_Value(r, 2, 1, 1)::INTEGER, ST_Value(r, 3, 1, 1)::INTEGER FROM (SELECT ST_Band(rast, [3, 1, 3]) AS r FROM multi);
----
3	3	1	3

query I
SELECT ST_NumBands(ST_Band(rast, []::INTEGER[])) FROM multi;
----
0

statement error
SELECT ST_Band(rast, 4) FROM multi;
----
Band 4 is out of range: the raster has 3 band(s)

statement error
SELECT ST_Band(rast, [1, 0]) FROM multi;
----
Band 0 is out of range
