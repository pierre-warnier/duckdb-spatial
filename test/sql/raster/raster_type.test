# name: test/sql/raster/raster_type.test
# group: [raster]

require spatial

# The type is a BLOB alias holding a GeoTIFF
query I
SELECT typeof(ST_MakeEmptyRaster(2, 2, 0, 0, 1));
----
RASTER

statement ok
CREATE TABLE rasters (id INTEGER, rast RASTER);

statement ok
INSERT INTO rasters VALUES
	(1, ST_AddBand(ST_MakeEmptyRaster(4, 3, 100, 200, 2, -2, 0, 0, 31370), '16BSI', 7, -1)),
	(2, NULL),
	(3, ST_MakeEmptyRaster(2, 2, 0, 0, 1));

query IIII
SELECT id, ST_Width(rast), ST_NumBands(rast), ST_SRID(rast) FROM rasters ORDER BY id;
----
1	4	1	31370
2	NULL	NULL	NULL
3	2	0	0

# RASTER -> BLOB is a reinterpretation: the bytes are a TIFF file
query II
SELECT typeof(rast::BLOB), hex(rast::BLOB)[1:8] FROM rasters WHERE id = 1;
----
BLOB	49492A00

# BLOB -> RASTER validates
query I
SELECT ST_Height((rast::BLOB)::RASTER) FROM rasters WHERE id = 1;
----
3

statement error
SELECT 'not a raster'::BLOB::RASTER;
----
not a GeoTIFF byte stream

query I
SELECT TRY_CAST('not a raster'::BLOB AS RASTER) IS NULL;
----
true

query I
SELECT count(*) FROM (SELECT TRY_CAST(b AS RASTER) AS r FROM (VALUES ('abc'::BLOB), (NULL), ('0123456789abcdef'::BLOB)) t(b)) WHERE r IS NULL;
----
3

# A BLOB is not implicitly a RASTER
statement error
SELECT ST_Width('abc'::BLOB);
----
Binder Error

# A GeoTIFF that was not written by this module casts directly, coordinate system included
query III
SELECT ST_Width(content::RASTER), ST_NumBands(content::RASTER), ST_SRID(content::RASTER) FROM read_blob('test/data/raster/rgb.tif');
----
8	3	4326

# NULL in, NULL out
query IIIII
SELECT ST_Width(NULL::RASTER), ST_Value(NULL::RASTER, 1, 1), ST_SetValue(NULL::RASTER, 1, 1, 1.0), ST_Envelope(NULL::RASTER), ST_MetaData(NULL::RASTER);
----
NULL	NULL	NULL	NULL	NULL

query III
SELECT ST_Value(rast, NULL, 1), ST_Value(rast, 1, 1, NULL), ST_AddBand(rast, NULL) FROM rasters WHERE id = 1;
----
NULL	NULL	NULL

# Untyped NULLs and string literals still bind to the geometry overloads of shared function names
query II
SELECT ST_Envelope(NULL), ST_ConvexHull(NULL);
----
NULL	NULL

query I
SELECT ST_AsText(ST_Envelope('LINESTRING (0 0, 1 1)'));
----
POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))

query I
SELECT ST_AsText(ST_ConvexHull('MULTIPOINT (0 0, 1 1, 1 0)'));
----
POLYGON ((0 0, 1 1, 1 0, 0 0))

query I
SELECT typeof(ST_Envelope(NULL));
----
GEOMETRY

query I
SELECT ST_SRID(NULL) IS NULL;
----
true

# A string is never a raster
statement error
SELECT ST_Width('abc');
----
not a GeoTIFF byte stream

# Rasters survive a checkpoint and a restart
load __TEST_DIR__/raster_type.db

statement ok
CREATE TABLE stored AS SELECT ST_SetValue(ST_AddBand(ST_MakeEmptyRaster(4, 3, 100, 200, 2, -2, 0, 0, 31370), '32BF', 1.5, -9999), 2, 3, 42) AS rast;

restart

query IIIII
SELECT typeof(rast), ST_Width(rast), ST_SRID(rast), ST_Value(rast, 2, 3)::INTEGER, ST_BandNoDataValue(rast)::INTEGER FROM stored;
----
RASTER	4	31370	42	-9999
