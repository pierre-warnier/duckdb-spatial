# ST_Resize
query II
SELECT ST_Width(r), ST_Height(r) FROM (SELECT ST_Resize(ST_AddBand(ST_MakeEmptyRaster(10, 10, 0, 0, 1), '8BUI', 1), '50%', '20') AS r);
----
5	20

