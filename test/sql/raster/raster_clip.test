# name: test/sql/raster/raster_clip.test
# group: [raster]

require spatial

# 10 x 10 pixels of 1 x 1, upper-left corner at (0, 10)
statement ok
CREATE TABLE q AS SELECT ST_AddBand(ST_MakeEmptyRaster(10, 10, 0, 10, 1, -1, 0, 0, 4326), '8BUI', 1, 0) AS rast;

statement ok
CREATE TABLE dem AS SELECT rast FROM ST_ReadRaster('test/data/raster/dem.tif');

# Cropped to the bounding box of the geometry: the valid pixels cover exactly the rectangle
query IIII
SELECT ST_MetaData(r)::VARCHAR, len(ST_PixelAsPoints(r)), ST_BandNoDataValue(r)::INTEGER, ST_BandPixelType(r) FROM (SELECT ST_Clip(rast, ST_MakeEnvelope(2, 2, 5, 6)) AS r FROM q);
----
{'upperleftx': 2.0, 'upperlefty': 6.0, 'width': 3, 'height': 4, 'scalex': 1.0, 'scaley': -1.0, 'skewx': 0.0, 'skewy': 0.0, 'srid': 4326, 'numbands': 1}	12	0	8BUI

query I
SELECT abs(sum(ST_Area(p.geom)) - ST_Area(ST_MakeEnvelope(2, 2, 5, 6))) < 1e-9 FROM (SELECT unnest(ST_PixelAsPolygons(ST_Clip(rast, ST_MakeEnvelope(2, 2, 5, 6)))) AS p FROM q);
----
true

# Not cropped: same grid, the outside is NODATA
query III
SELECT ST_MetaData(r) = ST_MetaData(rast), len(ST_PixelAsPoints(r)), ST_BandNoDataValue(r)::INTEGER
FROM (SELECT rast, ST_Clip(rast, ST_MakeEnvelope(2, 2, 5, 6), false) AS r FROM q);
----
true	12	0

query III
SELECT ST_Width(r), len(ST_PixelAsPoints(r)), ST_BandNoDataValue(r)::INTEGER FROM (SELECT ST_Clip(rast, ST_MakeEnvelope(2, 2, 5, 6), 9, false) AS r FROM q);
----
10	12	9

query III
SELECT ST_Width(r), len(ST_PixelAsPoints(r)), ST_BandNoDataValue(r)::INTEGER FROM (SELECT ST_Clip(rast, ST_MakeEnvelope(2, 2, 5, 6), 9) AS r FROM q);
----
3	12	9

# A literal NULL NODATA value means the default
query II
SELECT ST_Width(r), ST_BandNoDataValue(r)::INTEGER FROM (SELECT ST_Clip(rast, ST_MakeEnvelope(2, 2, 5, 6), NULL, true) AS r FROM q);
----
3	0

# A triangle: the 45 pixels whose centre is inside; with touched, the 55 pixels the triangle touches
query II
SELECT len(ST_PixelAsPoints(ST_Clip(rast, tri))), len(ST_PixelAsPoints(ST_Clip(rast, tri, NULL, true, true)))
FROM q, (SELECT ST_GeomFromText('POLYGON ((0 0, 9.7 0, 0 9.7, 0 0))') AS tri);
----
45	55

query I
SELECT len(ST_PixelAsPoints(ST_Clip(rast, tri, false, true))) = len(ST_PixelAsPoints(ST_Clip(rast, tri, NULL, true, true)))
FROM q, (SELECT ST_GeomFromText('POLYGON ((0 0, 9.7 0, 0 9.7, 0 0))') AS tri);
----
true

# Every kept pixel has its centre inside the geometry, every dropped one outside
query II
SELECT count(*), bool_and(ST_Contains(tri, p.geom) = (ST_Value(clipped, p.x, p.y) IS NOT NULL))
FROM (SELECT tri, clipped, unnest(ST_PixelAsCentroids(rast)) AS p
      FROM (SELECT rast, tri, ST_Clip(rast, tri, false) AS clipped FROM q, (SELECT ST_GeomFromText('POLYGON ((0.2 0.2, 9.7 1.3, 4.1 8.9, 0.2 0.2))') AS tri)));
----
100	true

# The values of the kept pixels do not change
query II
SELECT count(*) > 50, bool_and(p.val = ST_Value(rast, p.geom))
FROM (SELECT rast, unnest(ST_PixelAsCentroids(ST_Clip(rast, ST_Buffer(ST_Point(150150, 169880), 60)))) AS p FROM dem);
----
true	true

# The clipped area approaches the area of the geometry
query I
SELECT abs(len(ST_PixelAsPoints(ST_Clip(rast, ST_Buffer(ST_Point(150150, 169880), 60)))) * 100 - ST_Area(ST_Buffer(ST_Point(150150, 169880), 60))) / ST_Area(ST_Buffer(ST_Point(150150, 169880), 60)) < 0.05 FROM dem;
----
true

# A band without NODATA value gets the smallest value of its pixel type
query II
SELECT ST_BandNoDataValue(r) < -1e38, len(ST_PixelAsPoints(r)) FROM (SELECT ST_Clip(ST_AddBand(ST_MakeEmptyRaster(10, 10, 0, 10, 1), '32BF', 5), ST_MakeEnvelope(2, 2, 5, 6), false) AS r);
----
true	12

# With a band number the result has that band only
statement ok
CREATE TABLE rgb AS SELECT rast FROM ST_ReadRaster('test/data/raster/rgb.tif');

query IIII
SELECT ST_NumBands(ST_Clip(rast, g)), ST_NumBands(ST_Clip(rast, 2, g)), ST_Value(ST_Clip(rast, 2, g), 1, 1)::INTEGER, ST_Value(ST_Clip(rast, g), 3, 1, 1)::INTEGER
FROM rgb, (SELECT ST_MakeEnvelope(4.5, 49, 6, 50.5) AS g);
----
3	1	20	30

query IIII
SELECT ST_Width(ST_Clip(rast, 2, g, false)), ST_Width(ST_Clip(rast, 2, g, 7.0)), ST_BandNoDataValue(ST_Clip(rast, 2, g, 7.0, false))::INTEGER, ST_Width(ST_Clip(rast, 2, g, 7.0, true, true))
FROM rgb, (SELECT ST_MakeEnvelope(4.5, 49, 6, 50.5) AS g);
----
8	3	7	3

# Nothing in common, or nothing to clip with
query III
SELECT ST_Clip(rast, ST_MakeEnvelope(200, 2, 500, 6)) IS NULL, ST_Clip(rast, ST_GeomFromText('POLYGON EMPTY')) IS NULL, ST_Clip(rast, NULL::GEOMETRY) IS NULL FROM q;
----
true	true	true

statement error
SELECT ST_Clip(rast, 2, ST_MakeEnvelope(2, 2, 5, 6)) FROM q;
----
Band 2 is out of range

statement error
SELECT ST_Clip(ST_MakeEmptyRaster(rast), ST_MakeEnvelope(2, 2, 5, 6)) FROM q;
----
the raster has no bands
