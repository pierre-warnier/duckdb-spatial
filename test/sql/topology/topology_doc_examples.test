# name: test/sql/topology/topology_doc_examples.test
# description: The examples in the documentation of the topology functions run as written
# group: [topology]

require spatial

# The statements below are the examples registered with the functions, with the results their comments announce.
# Each one is first looked up in the registered example, so that the two cannot drift apart. The id shown by
# TopologySummary depends on how many topologies were created before and is normalized
query I
SELECT count(DISTINCT function_name) FROM duckdb_functions() WHERE tags['category'] = 'topology' AND len(examples) = 1;
----
30

# CreateTopology
query I
SELECT count(DISTINCT function_name) FROM duckdb_functions() WHERE function_name = 'CreateTopology' AND contains(regexp_replace(examples[1], '\s+', ' ', 'g'), 'CALL CreateTopology(''city'', 31370)');
----
1

statement ok
CALL CreateTopology('city', 31370);

query I
SELECT count(DISTINCT function_name) FROM duckdb_functions() WHERE function_name = 'CreateTopology' AND contains(regexp_replace(examples[1], '\s+', ' ', 'g'), 'SELECT * FROM topology.topology');
----
1

statement ok
SELECT * FROM topology.topology;

statement ok
CALL DropTopology('city');

