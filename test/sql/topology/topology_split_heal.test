# name: test/sql/topology/topology_split_heal.test
# description: ST_ModEdgeSplit, ST_NewEdgesSplit, ST_ModEdgeHeal, ST_NewEdgeHeal
# group: [topology]

require spatial

statement ok
CREATE MACRO edges(topo) AS TABLE
SELECT edge_id, start_node, end_node, next_left_edge, next_right_edge, left_face, right_face, ST_AsText(geom)
FROM query_table(topo || '.edge') ORDER BY edge_id;

statement ok
CREATE MACRO nodes(topo) AS TABLE
SELECT node_id, containing_face, ST_AsText(geom) FROM query_table(topo || '.node') ORDER BY node_id;

# Two adjacent squares: e1 is the shared edge, e2 closes the left square (face 1), e3 the right one (face 2)
statement ok
CALL CreateTopology('t');

statement ok
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(10, 0));

statement ok
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(10, 10));

statement ok
SELECT * FROM ST_AddEdgeModFace('t', 1, 2, ST_GeomFromText('LINESTRING(10 0, 10 10)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('t', 2, 1, ST_GeomFromText('LINESTRING(10 10, 0 10, 0 0, 10 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('t', 1, 2, ST_GeomFromText('LINESTRING(10 0, 20 0, 20 10, 10 10)'));

query IIIIIIIT
FROM edges('t');
----
1	1	2	2	3	1	2	LINESTRING (10 0, 10 10)
2	2	1	1	-3	1	0	LINESTRING (10 10, 0 10, 0 0, 10 0)
3	1	2	-1	-2	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)

# ----------------------------------------------------------------------------------------------------------------------
# ST_ModEdgeSplit: the edge keeps its id and its first part, a new edge takes the second part
# ----------------------------------------------------------------------------------------------------------------------
# Split on an existing vertex
query I
SELECT * FROM ST_ModEdgeSplit('t', 2, ST_Point(0, 10));
----
3

query IIIIIIIT
FROM edges('t');
----
1	1	2	2	3	1	2	LINESTRING (10 0, 10 10)
2	2	3	4	-3	1	0	LINESTRING (10 10, 0 10)
3	1	2	-1	-4	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)
4	3	1	1	-2	1	0	LINESTRING (0 10, 0 0, 10 0)

query IIT
FROM nodes('t');
----
1	NULL	POINT (10 0)
2	NULL	POINT (10 10)
3	NULL	POINT (0 10)

query TII
SELECT * FROM ValidateTopology('t');
----

# Split in the middle of a segment
query I
SELECT * FROM ST_ModEdgeSplit('t', 1, ST_Point(10, 4));
----
4

query IIIIIIIT
FROM edges('t');
----
1	1	4	5	3	1	2	LINESTRING (10 0, 10 4)
2	2	3	4	-3	1	0	LINESTRING (10 10, 0 10)
3	1	2	-5	-4	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)
4	3	1	1	-2	1	0	LINESTRING (0 10, 0 0, 10 0)
5	4	2	2	-1	1	2	LINESTRING (10 4, 10 10)

query TII
SELECT * FROM ValidateTopology('t');
----

query I
SELECT ST_Equals(st_getfacegeometry, ST_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))')) FROM ST_GetFaceGeometry('t', 1);
----
true

query I
SELECT ST_Equals(st_getfacegeometry, ST_GeomFromText('POLYGON((10 0, 20 0, 20 10, 10 10, 10 0))')) FROM ST_GetFaceGeometry('t', 2);
----
true

# ----------------------------------------------------------------------------------------------------------------------
# ST_ModEdgeHeal undoes the split: the first edge keeps its id and direction, the node goes away
# ----------------------------------------------------------------------------------------------------------------------
query I
SELECT * FROM ST_ModEdgeHeal('t', 1, 5);
----
4

query IIIIIIIT
FROM edges('t');
----
1	1	2	2	3	1	2	LINESTRING (10 0, 10 4, 10 10)
2	2	3	4	-3	1	0	LINESTRING (10 10, 0 10)
3	1	2	-1	-4	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)
4	3	1	1	-2	1	0	LINESTRING (0 10, 0 0, 10 0)

query IIT
FROM nodes('t');
----
1	NULL	POINT (10 0)
2	NULL	POINT (10 10)
3	NULL	POINT (0 10)

query TII
SELECT * FROM ValidateTopology('t');
----

# Healing in the other order keeps the direction of the first edge given: e4 (0 10 -> 10 0) absorbs e2 (10 10 -> 0 10)
query I
SELECT * FROM ST_ModEdgeHeal('t', 4, 2);
----
3

query IIIIIIIT
FROM edges('t');
----
1	1	2	4	3	1	2	LINESTRING (10 0, 10 4, 10 10)
3	1	2	-1	-4	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)
4	2	1	1	-3	1	0	LINESTRING (10 10, 0 10, 0 0, 10 0)

query TII
SELECT * FROM ValidateTopology('t');
----

# ----------------------------------------------------------------------------------------------------------------------
# ST_NewEdgesSplit replaces the edge by two new ones, ST_NewEdgeHeal replaces two edges by a new one
# ----------------------------------------------------------------------------------------------------------------------
query I
SELECT * FROM ST_NewEdgesSplit('t', 1, ST_Point(10, 4));
----
5

query IIIIIIIT
FROM edges('t');
----
3	1	2	-7	-4	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)
4	2	1	6	-3	1	0	LINESTRING (10 10, 0 10, 0 0, 10 0)
6	1	5	7	3	1	2	LINESTRING (10 0, 10 4)
7	5	2	4	-6	1	2	LINESTRING (10 4, 10 10)

query IIT
FROM nodes('t');
----
1	NULL	POINT (10 0)
2	NULL	POINT (10 10)
5	NULL	POINT (10 4)

query TII
SELECT * FROM ValidateTopology('t');
----

# The new edge has the direction of the first edge given: e6 (10 0 -> 10 4) followed by e7 (10 4 -> 10 10)
query I
SELECT * FROM ST_NewEdgeHeal('t', 7, 6);
----
8

query IIIIIIIT
FROM edges('t');
----
3	1	2	-8	-4	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)
4	2	1	8	-3	1	0	LINESTRING (10 10, 0 10, 0 0, 10 0)
8	1	2	4	3	1	2	LINESTRING (10 0, 10 4, 10 10)

query IIT
FROM nodes('t');
----
1	NULL	POINT (10 0)
2	NULL	POINT (10 10)

query TII
SELECT * FROM ValidateTopology('t');
----

query I
SELECT ST_Equals(st_getfacegeometry, ST_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))')) FROM ST_GetFaceGeometry('t', 1);
----
true

# ----------------------------------------------------------------------------------------------------------------------
# Closed and dangling edges
# ----------------------------------------------------------------------------------------------------------------------
statement ok
CALL CreateTopology('c');

statement ok
SELECT * FROM ST_AddIsoNode('c', NULL, ST_Point(0, 0));

statement ok
SELECT * FROM ST_AddEdgeModFace('c', 1, 1, ST_GeomFromText('LINESTRING(0 0, 10 0, 10 10, 0 10, 0 0)'));

# Splitting a closed edge gives two edges between the two nodes
query I
SELECT * FROM ST_ModEdgeSplit('c', 1, ST_Point(10, 10));
----
2

query IIIIIIIT
FROM edges('c');
----
1	1	2	2	-2	1	0	LINESTRING (0 0, 10 0, 10 10)
2	2	1	1	-1	1	0	LINESTRING (10 10, 0 10, 0 0)

query TII
SELECT * FROM ValidateTopology('c');
----

# Healing them back closes the edge again, on the node that is kept
query I
SELECT * FROM ST_ModEdgeHeal('c', 2, 1);
----
1

query IIIIIIIT
FROM edges('c');
----
2	2	2	2	-2	1	0	LINESTRING (10 10, 0 10, 0 0, 10 0, 10 10)

query IIT
FROM nodes('c');
----
2	NULL	POINT (10 10)

query TII
SELECT * FROM ValidateTopology('c');
----

# NewEdgesSplit on the closed edge
query I
SELECT * FROM ST_NewEdgesSplit('c', 2, ST_Point(0, 0));
----
3

query IIIIIIIT
FROM edges('c');
----
3	2	3	4	-4	1	0	LINESTRING (10 10, 0 10, 0 0)
4	3	2	3	-3	1	0	LINESTRING (0 0, 10 0, 10 10)

query TII
SELECT * FROM ValidateTopology('c');
----

# A dangling edge inside the face, split and healed
statement ok
SELECT * FROM ST_AddIsoNode('c', NULL, ST_Point(5, 5));

statement ok
SELECT * FROM ST_AddEdgeModFace('c', 3, 4, ST_GeomFromText('LINESTRING(0 0, 5 5)'));

query I
SELECT * FROM ST_ModEdgeSplit('c', 5, ST_Point(2, 2));
----
5

query IIIIIIIT
FROM edges('c');
----
3	2	3	5	-4	1	0	LINESTRING (10 10, 0 10, 0 0)
4	3	2	3	-3	1	0	LINESTRING (0 0, 10 0, 10 10)
5	3	5	6	4	1	1	LINESTRING (0 0, 2 2)
6	5	4	-6	-5	1	1	LINESTRING (2 2, 5 5)

query TII
SELECT * FROM ValidateTopology('c');
----

query I
SELECT * FROM ST_NewEdgeHeal('c', 6, 5);
----
7

query IIIIIIIT
FROM edges('c');
----
3	2	3	7	-4	1	0	LINESTRING (10 10, 0 10, 0 0)
4	3	2	3	-3	1	0	LINESTRING (0 0, 10 0, 10 10)
7	3	4	-7	4	1	1	LINESTRING (0 0, 2 2, 5 5)

query TII
SELECT * FROM ValidateTopology('c');
----

# ----------------------------------------------------------------------------------------------------------------------
# Edges that do not follow each other: the healed edge always has the direction of the first edge given
# ----------------------------------------------------------------------------------------------------------------------
statement ok
CALL CreateTopology('h');

foreach x 0 5 10 20 25 30 40 45 50 60 65 70

statement ok
SELECT * FROM ST_AddIsoNode('h', NULL, ST_Point(${x}, 0));

endloop

# Head to head (nodes 1-2-3 and 4-5-6), tail to tail (nodes 7-8-9 and 10-11-12)
statement ok
SELECT * FROM ST_AddEdgeModFace('h', 1, 2, ST_GeomFromText('LINESTRING(0 0, 5 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('h', 3, 2, ST_GeomFromText('LINESTRING(10 0, 5 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('h', 4, 5, ST_GeomFromText('LINESTRING(20 0, 25 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('h', 6, 5, ST_GeomFromText('LINESTRING(30 0, 25 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('h', 8, 7, ST_GeomFromText('LINESTRING(45 0, 40 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('h', 8, 9, ST_GeomFromText('LINESTRING(45 0, 50 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('h', 11, 10, ST_GeomFromText('LINESTRING(65 0, 60 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('h', 11, 12, ST_GeomFromText('LINESTRING(65 0, 70 0)'));

query TII
SELECT * FROM ValidateTopology('h');
----

query I
SELECT * FROM ST_ModEdgeHeal('h', 1, 2);
----
2

query I
SELECT * FROM ST_ModEdgeHeal('h', 4, 3);
----
5

query I
SELECT * FROM ST_ModEdgeHeal('h', 5, 6);
----
8

query I
SELECT * FROM ST_NewEdgeHeal('h', 8, 7);
----
9

query IIIIIIIT
FROM edges('h');
----
1	1	3	-1	1	0	0	LINESTRING (0 0, 5 0, 10 0)
4	6	4	-4	4	0	0	LINESTRING (30 0, 25 0, 20 0)
5	9	7	-5	5	0	0	LINESTRING (50 0, 45 0, 40 0)
9	10	12	-9	9	0	0	LINESTRING (60 0, 65 0, 70 0)

query I
SELECT list(node_id ORDER BY node_id) FROM h.node;
----
[1, 3, 4, 6, 7, 9, 10, 12]

query TII
SELECT * FROM ValidateTopology('h');
----

# ----------------------------------------------------------------------------------------------------------------------
# Error conditions
# ----------------------------------------------------------------------------------------------------------------------
statement error
SELECT * FROM ST_ModEdgeSplit('c', 99, ST_Point(2, 2));
----
SQL/MM Spatial exception - non-existent edge

statement error
SELECT * FROM ST_NewEdgesSplit('c', 99, ST_Point(2, 2));
----
SQL/MM Spatial exception - non-existent edge

statement error
SELECT * FROM ST_ModEdgeSplit('c', 7, ST_Point(2, 3));
----
SQL/MM Spatial exception - point not on edge

statement error
SELECT * FROM ST_NewEdgesSplit('c', 7, ST_Point(6, 6));
----
SQL/MM Spatial exception - point not on edge

statement error
SELECT * FROM ST_ModEdgeSplit('c', 7, ST_Point(5, 5));
----
SQL/MM Spatial exception - coincident node

statement error
SELECT * FROM ST_NewEdgesSplit('c', 7, ST_Point(0, 0));
----
SQL/MM Spatial exception - coincident node

statement error
SELECT * FROM ST_ModEdgeSplit('c', 7, ST_GeomFromText('LINESTRING(1 1, 2 2)'));
----
SQL/MM Spatial exception - invalid point

statement error
SELECT * FROM ST_ModEdgeSplit('c', 7, NULL);
----
SQL/MM Spatial exception - null argument

statement error
SELECT * FROM ST_ModEdgeHeal('c', 7, 7);
----
Cannot heal edge 7 with itself, try with another

statement error
SELECT * FROM ST_ModEdgeHeal('c', 7, 99);
----
SQL/MM Spatial exception - non-existent edge 99

statement error
SELECT * FROM ST_NewEdgeHeal('c', 99, 7);
----
SQL/MM Spatial exception - non-existent edge 99

# Node 3 (0 0) joins three edges
statement error
SELECT * FROM ST_ModEdgeHeal('c', 3, 7);
----
SQL/MM Spatial exception - other edges connected (4)

statement error
SELECT * FROM ST_NewEdgeHeal('c', 7, 4);
----
SQL/MM Spatial exception - other edges connected (3)

statement ok
SELECT * FROM ST_AddIsoNode('c', NULL, ST_Point(20, 20));

statement ok
SELECT * FROM ST_AddIsoNode('c', NULL, ST_Point(30, 20));

statement ok
SELECT * FROM ST_AddIsoEdge('c', 6, 7, ST_GeomFromText('LINESTRING(20 20, 30 20)'));

statement error
SELECT * FROM ST_ModEdgeHeal('c', 7, 8);
----
SQL/MM Spatial exception - non-connected edges

statement ok
SELECT * FROM ST_AddEdgeModFace('c', 7, 7, ST_GeomFromText('LINESTRING(30 20, 40 20, 40 30, 30 20)'));

statement error
SELECT * FROM ST_ModEdgeHeal('c', 9, 8);
----
Edge 9 is closed, cannot heal to edge 8

statement error
SELECT * FROM ST_NewEdgeHeal('c', 8, 9);
----
Edge 9 is closed, cannot heal to edge 8

statement error
SELECT * FROM ST_NewEdgeHeal('c', NULL, 9);
----
SQL/MM Spatial exception - null argument

query TII
SELECT * FROM ValidateTopology('c');
----
