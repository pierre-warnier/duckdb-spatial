# name: test/sql/topology/topology_topoelementarray_agg.test
# description: TopoElementArray_Agg
# group: [topology]

require spatial

# INTEGER[2] elements
query T
SELECT TopoElementArray_Agg([x, 3]::INTEGER[2] ORDER BY x) FROM range(1, 4) t(x);
----
[[1, 3], [2, 3], [3, 3]]

query T
SELECT typeof(TopoElementArray_Agg([x, 3]::INTEGER[2])) FROM range(1, 4) t(x);
----
INTEGER[2][]

query T
SELECT TopoElementArray_Agg([x, 2]::INTEGER[2] ORDER BY x DESC) FROM range(1, 4) t(x);
----
[[3, 2], [2, 2], [1, 2]]

# INTEGER[] lists of two values are cast implicitly
query T
SELECT TopoElementArray_Agg([face_id, 3] ORDER BY face_id) FROM (VALUES (1), (2), (3)) t(face_id);
----
[[1, 3], [2, 3], [3, 3]]

query T
SELECT typeof(TopoElementArray_Agg([face_id, 3])) FROM (VALUES (1), (2), (3)) t(face_id);
----
INTEGER[2][]

# Grouped, with both argument forms side by side
query ITT
SELECT x % 2 AS g,
       TopoElementArray_Agg([x::INTEGER, 1] ORDER BY x),
       TopoElementArray_Agg([x, 1]::INTEGER[2] ORDER BY x)
FROM range(1, 7) t(x) GROUP BY g ORDER BY g;
----
0	[[2, 1], [4, 1], [6, 1]]	[[2, 1], [4, 1], [6, 1]]
1	[[1, 1], [3, 1], [5, 1]]	[[1, 1], [3, 1], [5, 1]]

# NULL rows are skipped, no rows give NULL
query T
SELECT TopoElementArray_Agg(e ORDER BY e[1]) FROM (VALUES ([1, 3]::INTEGER[2]), (NULL), ([2, 3]::INTEGER[2])) t(e);
----
[[1, 3], [2, 3]]

query T
SELECT TopoElementArray_Agg(e ORDER BY e[1]) FROM (VALUES ([1, 3]), (NULL), ([2, 3])) t(e);
----
[[1, 3], [2, 3]]

query T
SELECT TopoElementArray_Agg([x, 3]::INTEGER[2]) FROM range(1, 4) t(x) WHERE x > 10;
----
NULL

query T
SELECT TopoElementArray_Agg([x::INTEGER, 3]) FROM range(1, 4) t(x) WHERE x > 10;
----
NULL

query T
SELECT TopoElementArray_Agg(NULL::INTEGER[2]);
----
NULL

# Many rows, in parallel: nothing is lost
query II
SELECT len(elements), list_sum(list_transform(elements, e -> e[1])) FROM (
	SELECT TopoElementArray_Agg([x::INTEGER, 2]) AS elements FROM range(1, 100001) t(x));
----
100000	5000050000

query I
SELECT count(*) FROM (
	SELECT x % 1000 AS g, TopoElementArray_Agg([x, 2]::INTEGER[2] ORDER BY x) AS elements FROM range(100000) t(x) GROUP BY g)
WHERE len(elements) = 100 AND elements[1][1] = g AND elements[100][1] = g + 99000 AND elements[7][2] = 2;
----
1000

# Used as a window aggregate
query IT
SELECT x, TopoElementArray_Agg([x::INTEGER, 1]) OVER (ORDER BY x) FROM range(1, 4) t(x) ORDER BY x;
----
1	[[1, 1]]
2	[[1, 1], [2, 1]]
3	[[1, 1], [2, 1], [3, 1]]

# Malformed elements
statement error
SELECT TopoElementArray_Agg([x::INTEGER, 3, 4]) FROM range(1, 4) t(x);
----
Cannot cast list with length 3 to array with length 2

statement error
SELECT TopoElementArray_Agg([x::INTEGER]) FROM range(1, 4) t(x);
----
Cannot cast list with length 1 to array with length 2

statement error
SELECT TopoElementArray_Agg([x::INTEGER, NULL]) FROM range(1, 4) t(x);
----
TopoElementArray_Agg: a TopoElement cannot hold NULL values

statement error
SELECT TopoElementArray_Agg([x, NULL]::INTEGER[2]) FROM range(1, 4) t(x);
----
TopoElementArray_Agg: a TopoElement cannot hold NULL values

# The faces of a topology as a TopoElementArray
statement ok
CALL CreateTopology('t');

statement ok
SELECT * FROM ST_CreateTopoGeo('t', ST_GeomFromText('MULTIPOLYGON(((0 0, 10 0, 10 10, 0 10, 0 0)), ((10 0, 20 0, 20 10, 10 10, 10 0)))'));

query T
SELECT TopoElementArray_Agg([face_id, 3] ORDER BY face_id) FROM t.face WHERE face_id <> 0;
----
[[1, 3], [2, 3]]
