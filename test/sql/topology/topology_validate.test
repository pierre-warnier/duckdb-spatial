# name: test/sql/topology/topology_validate.test
# description: ValidateTopology: every error class, triggered by corrupting the topology tables with plain SQL
# group: [topology]

require spatial

# One copy of the same valid topology per corruption:
#
#   (0,10) +---------e2--+ n2 ---------e3---+ (20,10)
#          |             ^                  |
#          |  f1   n4    | e1    f2  [f3]   |      f3: hole of f2 made of the closed edge e4 on n3 (14 4)
#          |             |                  |      n4: isolated node (5 5) in f1
#    (0,0) +-------------+ n1 --------------+ (20,0)
foreach topo nodes crossnode invalid notsimple crossedge mismatch noedges links mixed shell multi mbr hole within isonodes

statement ok
CALL CreateTopology('${topo}');

statement ok
SELECT * FROM ST_AddIsoNode('${topo}', NULL, ST_Point(10, 0));

statement ok
SELECT * FROM ST_AddIsoNode('${topo}', NULL, ST_Point(10, 10));

statement ok
SELECT * FROM ST_AddEdgeModFace('${topo}', 1, 2, ST_GeomFromText('LINESTRING(10 0, 10 10)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('${topo}', 2, 1, ST_GeomFromText('LINESTRING(10 10, 0 10, 0 0, 10 0)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('${topo}', 1, 2, ST_GeomFromText('LINESTRING(10 0, 20 0, 20 10, 10 10)'));

statement ok
SELECT * FROM ST_AddIsoNode('${topo}', NULL, ST_Point(14, 4));

statement ok
SELECT * FROM ST_AddEdgeModFace('${topo}', 3, 3, ST_GeomFromText('LINESTRING(14 4, 18 4, 18 8, 14 8, 14 4)'));

statement ok
SELECT * FROM ST_AddIsoNode('${topo}', NULL, ST_Point(5, 5));

query TII
SELECT * FROM ValidateTopology('${topo}');
----

endloop

query IIIIIIIT
SELECT edge_id, start_node, end_node, next_left_edge, next_right_edge, left_face, right_face, ST_AsText(geom) FROM nodes.edge ORDER BY edge_id;
----
1	1	2	2	3	1	2	LINESTRING (10 0, 10 10)
2	2	1	1	-3	1	0	LINESTRING (10 10, 0 10, 0 0, 10 0)
3	1	2	-1	-2	2	0	LINESTRING (10 0, 20 0, 20 10, 10 10)
4	3	3	4	-4	3	2	LINESTRING (14 4, 18 4, 18 8, 14 8, 14 4)

# coincident nodes
statement ok
INSERT INTO nodes.node VALUES (10, 1, ST_Point(5, 5)), (11, 1, ST_Point(5, 5));

query TII
SELECT * FROM ValidateTopology('nodes');
----
coincident nodes	4	10
coincident nodes	4	11
coincident nodes	10	11

# edge crosses node: a node on the interior of e1, and one on a vertex of e2
statement ok
INSERT INTO crossnode.node VALUES (10, 1, ST_Point(10, 5)), (11, 1, ST_Point(0, 10));

query TII
SELECT * FROM ValidateTopology('crossnode');
----
edge crosses node	1	10
edge crosses node	2	11

# invalid edge: no two distinct vertices (its end point no longer matches its end node either)
statement ok
UPDATE invalid.edge_data SET geom = ST_GeomFromText('LINESTRING(10 0, 10 0)') WHERE edge_id = 1;

query TII
SELECT * FROM ValidateTopology('invalid');
----
invalid edge	1	NULL
edge end node geometry mismatch	1	2
invalid next_left_edge	2	3
invalid next_left_edge	3	2

# edge not simple
statement ok
UPDATE notsimple.edge_data SET geom = ST_GeomFromText('LINESTRING(10 10, 0 10, 7 4, 7 12, 0 0, 10 0)') WHERE edge_id = 2;

query TII
SELECT * FROM ValidateTopology('notsimple');
----
edge not simple	2	NULL

# edge crosses edge: e3 now cuts through e1 and e4. It also leaves n1 on the other side of e1, which changes the
# links expected there
statement ok
UPDATE crossedge.edge_data SET geom = ST_GeomFromText('LINESTRING(10 0, 3 6, 20 6, 10 10)') WHERE edge_id = 3;

query TII
SELECT * FROM ValidateTopology('crossedge');
----
edge crosses edge	1	3
edge crosses edge	3	4
invalid next_right_edge	1	-2
invalid next_left_edge	2	3
invalid next_right_edge	3	1

# edge start / end node geometry mismatch: n1 is moved without its edges
statement ok
UPDATE mismatch.node SET geom = ST_Point(10, 1) WHERE node_id = 1;

query TII
SELECT * FROM ValidateTopology('mismatch');
----
edge start node geometry mismatch	1	1
edge start node geometry mismatch	3	1
edge end node geometry mismatch	2	1

# face without edges
statement ok
INSERT INTO noedges.face VALUES (9, ST_MakeEnvelope(0, 0, 1, 1));

query TII
SELECT * FROM ValidateTopology('noedges');
----
face without edges	9	NULL

# invalid next_left_edge / next_right_edge: the second value is the expected link
statement ok
UPDATE links.edge_data SET next_left_edge = -1, abs_next_left_edge = 1 WHERE edge_id = 1;

statement ok
UPDATE links.edge_data SET next_right_edge = 1, abs_next_right_edge = 1 WHERE edge_id = 3;

query TII
SELECT * FROM ValidateTopology('links');
----
invalid next_left_edge	1	2
invalid next_right_edge	3	-2

# mixed face labeling in ring: the ring e1, e2 around face 1 now says face 1 then face 2.
# Face 1 is left without a ring of its own
statement ok
UPDATE mixed.edge_data SET left_face = 2 WHERE edge_id = 2;

query TII
SELECT * FROM ValidateTopology('mixed');
----
mixed face labeling in ring	1	NULL
face has no rings	1	NULL
isolated node has wrong containing_face	4	NULL

# universal face has shell rings: the ring around face 1 is labelled 0, which also leaves face 1 without edges and
# its isolated node in the wrong face
statement ok
UPDATE shell.edge_data SET left_face = 0 WHERE left_face = 1;

query TII
SELECT * FROM ValidateTopology('shell');
----
face without edges	1	NULL
universal face has shell rings	0	1
isolated node has wrong containing_face	4	NULL

# face has multiple shells: both squares are labelled face 1
statement ok
UPDATE multi.edge_data SET right_face = 1 WHERE edge_id IN (1, 4);

statement ok
UPDATE multi.edge_data SET left_face = 1 WHERE edge_id = 3;

query TII
SELECT * FROM ValidateTopology('multi');
----
face without edges	2	NULL
face has multiple shells	1	-1

# face has wrong mbr
statement ok
UPDATE mbr.face SET mbr = ST_MakeEnvelope(0, 0, 10, 11) WHERE face_id = 1;

statement ok
UPDATE mbr.face SET mbr = NULL WHERE face_id = 3;

query TII
SELECT * FROM ValidateTopology('mbr');
----
face has wrong mbr	1	NULL
face has wrong mbr	3	NULL

# hole not in advertised face: the outside of the hole e4 is said to be face 1. Face 2 then has no hole, so that
# face 3 lies within it, and face 1 claims the area of the hole as a second part, inside face 2
statement ok
UPDATE hole.edge_data SET right_face = 1 WHERE edge_id = 4;

query TII
SELECT * FROM ValidateTopology('hole');
----
hole not in advertised face	-4	NULL
face overlaps face	1	2
face within face	3	1
face within face	3	2

# face within face, with the hole attributed to the universal face
statement ok
UPDATE within.edge_data SET right_face = 0 WHERE edge_id = 4;

query TII
SELECT * FROM ValidateTopology('within');
----
hole not in advertised face	-4	NULL
face within face	3	2

# containing_face of nodes
statement ok
UPDATE isonodes.node SET containing_face = 1 WHERE node_id = 1;

statement ok
UPDATE isonodes.node SET containing_face = 2 WHERE node_id = 4;

statement ok
INSERT INTO isonodes.node VALUES (10, NULL, ST_Point(16, 6)), (11, 2, ST_Point(16, 7)), (12, 3, ST_Point(30, 30)), (13, 0, ST_Point(40, 40)), (14, 3, ST_Point(17, 7));

query TII
SELECT * FROM ValidateTopology('isonodes');
----
not-isolated node has not-null containing_face	1	NULL
isolated node has wrong containing_face	4	NULL
isolated node has null containing_face	10	NULL
isolated node has wrong containing_face	11	NULL
isolated node has wrong containing_face	12	NULL

# ----------------------------------------------------------------------------------------------------------------------
# face overlaps face: three squares in a row, relabelled so that one face claims A + B and another one B + C
# ----------------------------------------------------------------------------------------------------------------------
statement ok
CALL CreateTopology('overlap');

statement ok
SELECT * FROM ST_CreateTopoGeo('overlap', ST_GeomFromText('MULTIPOLYGON(((0 0, 10 0, 10 10, 0 10, 0 0)), ((10 0, 20 0, 20 10, 10 10, 10 0)), ((20 0, 30 0, 30 10, 20 10, 20 0)))'));

query TII
SELECT * FROM ValidateTopology('overlap');
----

query IIIT
SELECT edge_id, left_face, right_face, ST_AsText(geom) FROM overlap.edge ORDER BY edge_id;
----
1	1	2	LINESTRING (10 0, 10 10)
2	2	0	LINESTRING (10 0, 20 0)
3	1	0	LINESTRING (10 10, 0 10, 0 0, 10 0)
4	2	3	LINESTRING (20 0, 20 10)
5	3	0	LINESTRING (20 0, 30 0, 30 10, 20 10)
6	2	0	LINESTRING (20 10, 10 10)

query I
SELECT list(face_id ORDER BY face_id) FROM overlap.face;
----
[0, 1, 2, 3]

# Face 1 gets the outline of A + B (the A|B edge is inside it), face 2 the outline of B + C
statement ok
UPDATE overlap.edge_data SET
	left_face = CASE
		WHEN ST_Equals(geom, ST_GeomFromText('LINESTRING(10 0, 10 10)')) THEN 2
		WHEN ST_Equals(geom, ST_GeomFromText('LINESTRING(20 0, 20 10)')) THEN 1
		WHEN ST_XMax(geom) <= 10 THEN 1
		WHEN ST_XMin(geom) >= 20 THEN 2
		ELSE 1 END,
	right_face = CASE
		WHEN ST_XMin(geom) >= 10 AND ST_XMax(geom) <= 20 AND ST_XMin(geom) <> ST_XMax(geom) THEN 2
		ELSE 0 END;

query T
SELECT ST_AsText(ST_Normalize(st_getfacegeometry)) FROM ST_GetFaceGeometry('overlap', 1);
----
POLYGON ((0 0, 0 10, 10 10, 20 10, 20 0, 10 0, 0 0))

query T
SELECT ST_AsText(ST_Normalize(st_getfacegeometry)) FROM ST_GetFaceGeometry('overlap', 2);
----
POLYGON ((10 0, 10 10, 20 10, 30 10, 30 0, 20 0, 10 0))

query TII
SELECT * FROM ValidateTopology('overlap') WHERE error LIKE 'face %laps face';
----
face overlaps face	1	2

# ----------------------------------------------------------------------------------------------------------------------
# Arguments
# ----------------------------------------------------------------------------------------------------------------------
statement error
SELECT * FROM ValidateTopology(NULL);
----
SQL/MM Spatial exception - null argument

statement error
SELECT * FROM ValidateTopology('nope');
----
SQL/MM Spatial exception - invalid topology name

# An empty topology is valid
statement ok
CALL CreateTopology('empty');

query TII
SELECT * FROM ValidateTopology('empty');
----
