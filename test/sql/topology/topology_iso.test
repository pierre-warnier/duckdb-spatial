# name: test/sql/topology/topology_iso.test
# description: Isolated nodes and edges: ST_AddIsoNode, ST_MoveIsoNode, ST_RemoveIsoNode, ST_AddIsoEdge, ST_RemoveIsoEdge
# group: [topology]

require spatial

statement ok
CALL CreateTopology('t');

# A square face (1) made of one closed edge, to have two faces to put nodes in
statement ok
SELECT * FROM ST_CreateTopoGeo('t', ST_GeomFromText('POLYGON((0 0, 10 0, 10 10, 0 10, 0 0))'));

query IIIIIIIT
SELECT edge_id, start_node, end_node, next_left_edge, next_right_edge, left_face, right_face, ST_AsText(geom) FROM t.edge;
----
1	1	1	1	-1	1	0	LINESTRING (0 0, 10 0, 10 10, 0 10, 0 0)

# ST_AddIsoNode computes the containing face when none is given
query I
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(2, 2));
----
2

query I
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(20, 20));
----
3

query I
SELECT * FROM ST_AddIsoNode('t', 1, ST_Point(8, 2));
----
4

query I
SELECT * FROM ST_AddIsoNode('t', 0, ST_Point(30, 20));
----
5

query IIT
SELECT node_id, containing_face, ST_AsText(geom) FROM t.node ORDER BY node_id;
----
1	NULL	POINT (0 0)
2	1	POINT (2 2)
3	0	POINT (20 20)
4	1	POINT (8 2)
5	0	POINT (30 20)

query TII
SELECT * FROM ValidateTopology('t');
----

statement error
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(2, 2));
----
SQL/MM Spatial exception - coincident node

statement error
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(0, 0));
----
SQL/MM Spatial exception - coincident node

statement error
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(5, 0));
----
SQL/MM Spatial exception - edge crosses node.

statement error
SELECT * FROM ST_AddIsoNode('t', 0, ST_Point(5, 5));
----
SQL/MM Spatial exception - not within face

statement error
SELECT * FROM ST_AddIsoNode('t', 1, ST_Point(50, 5));
----
SQL/MM Spatial exception - not within face

statement error
SELECT * FROM ST_AddIsoNode('t', 7, ST_Point(5, 5));
----
SQL/MM Spatial exception - not within face

statement error
SELECT * FROM ST_AddIsoNode('t', NULL, ST_GeomFromText('LINESTRING(1 1, 2 2)'));
----
SQL/MM Spatial exception - invalid point

statement error
SELECT * FROM ST_AddIsoNode('t', NULL, NULL);
----
SQL/MM Spatial exception - null argument

statement error
SELECT * FROM ST_AddIsoNode(NULL, NULL, ST_Point(1, 1));
----
SQL/MM Spatial exception - null argument

statement error
SELECT * FROM ST_AddIsoNode('nope', NULL, ST_Point(1, 1));
----
SQL/MM Spatial exception - invalid topology name

# None of the failed calls changed anything
query I
SELECT count(*) FROM t.node;
----
5

# ST_MoveIsoNode
query T
SELECT * FROM ST_MoveIsoNode('t', 2, ST_Point(3, 3.5));
----
Isolated Node 2 moved to location 3,3.5

query IIT
SELECT node_id, containing_face, ST_AsText(geom) FROM t.node WHERE node_id = 2;
----
2	1	POINT (3 3.5)

statement error
SELECT * FROM ST_MoveIsoNode('t', 2, ST_Point(30, 30));
----
Cannot move isolated node across faces

statement error
SELECT * FROM ST_MoveIsoNode('t', 3, ST_Point(5, 5));
----
Cannot move isolated node across faces

statement error
SELECT * FROM ST_MoveIsoNode('t', 2, ST_Point(8, 2));
----
SQL/MM Spatial exception - coincident node

statement error
SELECT * FROM ST_MoveIsoNode('t', 2, ST_Point(10, 5));
----
SQL/MM Spatial exception - edge crosses node.

statement error
SELECT * FROM ST_MoveIsoNode('t', 1, ST_Point(1, 1));
----
SQL/MM Spatial exception - not isolated node

statement error
SELECT * FROM ST_MoveIsoNode('t', 99, ST_Point(1, 1));
----
SQL/MM Spatial exception - non-existent node

statement error
SELECT * FROM ST_MoveIsoNode('t', 2, ST_GeomFromText('LINESTRING(1 1, 2 2)'));
----
SQL/MM Spatial exception - invalid point

statement error
SELECT * FROM ST_MoveIsoNode('t', NULL, ST_Point(1, 1));
----
SQL/MM Spatial exception - null argument

query TII
SELECT * FROM ValidateTopology('t');
----

# ST_AddIsoEdge joins two isolated nodes of one face
statement error
SELECT * FROM ST_AddIsoEdge('t', 2, 3, ST_GeomFromText('LINESTRING(3 3.5, 20 20)'));
----
SQL/MM Spatial exception - nodes in different faces

statement error
SELECT * FROM ST_AddIsoEdge('t', 1, 2, ST_GeomFromText('LINESTRING(0 0, 3 3.5)'));
----
SQL/MM Spatial exception - not isolated node

statement error
SELECT * FROM ST_AddIsoEdge('t', 2, 99, ST_GeomFromText('LINESTRING(3 3.5, 8 2)'));
----
SQL/MM Spatial exception - non-existent node

statement error
SELECT * FROM ST_AddIsoEdge('t', 2, 2, ST_GeomFromText('LINESTRING(3 3.5, 4 4, 4 3, 3 3.5)'));
----
Closed edges would not be isolated, try ST_AddEdgeNewFaces

statement error
SELECT * FROM ST_AddIsoEdge('t', 2, 4, ST_GeomFromText('LINESTRING(3 3, 8 2)'));
----
SQL/MM Spatial exception - start node not geometry start point.

statement error
SELECT * FROM ST_AddIsoEdge('t', 2, 4, ST_GeomFromText('LINESTRING(3 3.5, 8 3)'));
----
SQL/MM Spatial exception - end node not geometry end point.

statement error
SELECT * FROM ST_AddIsoEdge('t', 2, 4, ST_GeomFromText('LINESTRING(3 3.5, 9 9, 3 9, 9 3.5, 8 2)'));
----
SQL/MM Spatial exception - curve not simple

statement error
SELECT * FROM ST_AddIsoEdge('t', 2, 4, ST_Point(3, 3.5));
----
SQL/MM Spatial exception - invalid curve

statement error
SELECT * FROM ST_AddIsoEdge('t', 3, 5, ST_GeomFromText('LINESTRING(20 20, 5 5, 30 20)'));
----
SQL/MM Spatial exception - geometry crosses edge 1

query I
SELECT * FROM ST_AddIsoEdge('t', 2, 4, ST_GeomFromText('LINESTRING(3 3.5, 5 5, 8 2)'));
----
2

query IIIIIIIT
SELECT edge_id, start_node, end_node, next_left_edge, next_right_edge, left_face, right_face, ST_AsText(geom) FROM t.edge ORDER BY edge_id;
----
1	1	1	1	-1	1	0	LINESTRING (0 0, 10 0, 10 10, 0 10, 0 0)
2	2	4	-2	2	1	1	LINESTRING (3 3.5, 5 5, 8 2)

query IIII
SELECT edge_id, abs_next_left_edge, abs_next_right_edge, left_face FROM t.edge_data ORDER BY edge_id;
----
1	1	1	1
2	2	2	1

# Its end nodes are not isolated any more
query II
SELECT node_id, containing_face FROM t.node ORDER BY node_id;
----
1	NULL
2	NULL
3	0
4	NULL
5	0

query TII
SELECT * FROM ValidateTopology('t');
----

# An isolated edge does not bound any face
query T
SELECT ST_AsText(st_getfacegeometry) FROM ST_GetFaceGeometry('t', 1);
----
POLYGON ((0 0, 0 10, 10 10, 10 0, 0 0))

statement error
SELECT * FROM ST_AddIsoEdge('t', 3, 5, ST_GeomFromText('LINESTRING(20 20, 30 20)'), 1);
----
No function matches

query I
SELECT * FROM ST_AddIsoEdge('t', 3, 5, ST_GeomFromText('LINESTRING(20 20, 30 20)'));
----
3

# A node in the way of the new edge
statement ok
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(40, 20));

statement ok
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(50, 20));

statement ok
SELECT * FROM ST_AddIsoNode('t', NULL, ST_Point(60, 20));

statement error
SELECT * FROM ST_AddIsoEdge('t', 6, 8, ST_GeomFromText('LINESTRING(40 20, 60 20)'));
----
SQL/MM Spatial exception - geometry crosses a node

# ST_RemoveIsoNode
statement error
SELECT * FROM ST_RemoveIsoNode('t', 2);
----
SQL/MM Spatial exception - not isolated node

statement error
SELECT * FROM ST_RemoveIsoNode('t', 99);
----
SQL/MM Spatial exception - non-existent node

query T
SELECT * FROM ST_RemoveIsoNode('t', 7);
----
Isolated node 7 removed

query I
SELECT count(*) FROM t.node WHERE node_id = 7;
----
0

# ST_RemoveIsoEdge
statement error
SELECT * FROM ST_RemoveIsoEdge('t', 1);
----
SQL/MM Spatial exception - not isolated edge

statement error
SELECT * FROM ST_RemoveIsoEdge('t', 99);
----
SQL/MM Spatial exception - non-existent edge

query T
SELECT * FROM ST_RemoveIsoEdge('t', 2);
----
Isolated edge 2 removed

query T
SELECT * FROM ST_RemoveIsoEdge('t', 3);
----
Isolated edge 3 removed

# The end nodes are isolated again, in the face the edge was in
query II
SELECT node_id, containing_face FROM t.node ORDER BY node_id;
----
1	NULL
2	1
3	0
4	1
5	0
6	0
8	0

query I
SELECT count(*) FROM t.edge;
----
1

query TII
SELECT * FROM ValidateTopology('t');
----

# An edge sharing a node with another one is not isolated
statement ok
SELECT * FROM ST_AddIsoEdge('t', 3, 5, ST_GeomFromText('LINESTRING(20 20, 30 20)'));

statement ok
SELECT * FROM ST_AddEdgeModFace('t', 5, 6, ST_GeomFromText('LINESTRING(30 20, 40 20)'));

statement error
SELECT * FROM ST_RemoveIsoEdge('t', 4);
----
SQL/MM Spatial exception - not isolated edge

query TII
SELECT * FROM ValidateTopology('t');
----
