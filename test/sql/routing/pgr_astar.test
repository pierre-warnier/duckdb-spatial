# name: test/sql/routing/pgr_astar.test
# description: Test pgr_aStar, pgr_bdDijkstra and pgr_bdAstar
# group: [routing]

require spatial

# The pgRouting sample graph
statement ok
CREATE TABLE edges AS SELECT * FROM (VALUES
	(1, 5, 6, 1, 1, 2, 0, 2, 1), (2, 6, 10, -1, 1, 2, 1, 3, 1), (3, 10, 15, -1, 1, 3, 1, 4, 1),
	(4, 6, 7, 1, 1, 2, 1, 2, 2), (5, 10, 11, 1, -1, 3, 1, 3, 2), (6, 1, 3, 1, 1, 0, 2, 1, 2),
	(7, 3, 7, 1, 1, 1, 2, 2, 2), (8, 7, 11, 1, 1, 2, 2, 3, 2), (9, 11, 16, 1, 1, 3, 2, 4, 2),
	(10, 7, 8, 1, 1, 2, 2, 2, 3), (11, 11, 12, 1, -1, 3, 2, 3, 3), (12, 8, 12, 1, -1, 2, 3, 3, 3),
	(13, 12, 17, 1, -1, 3, 3, 4, 3), (14, 8, 9, 1, 1, 2, 3, 2, 4), (15, 16, 17, 1, 1, 4, 2, 4, 3),
	(16, 15, 16, 1, 1, 4, 1, 4, 2), (17, 2, 4, 1, 1, 0.5, 3.5, 1.999999999999, 3.5), (18, 13, 14, 1, 1, 3.5, 2.3, 3.5, 4)
) t(id, source, target, cost, reverse_cost, x1, y1, x2, y2);

query IIIIIIRR
SELECT * FROM pgr_aStar((SELECT id, source, target, cost, reverse_cost, x1, y1, x2, y2 FROM edges), 6, 12);
----
1	1	6	12	6	4	1.0	0.0
2	2	6	12	7	10	1.0	1.0
3	3	6	12	8	12	1.0	2.0
4	4	6	12	12	-1	0.0	3.0

query IIIIIIRR
SELECT * FROM pgr_aStar((SELECT * FROM edges), 6, 10, directed := false, heuristic := 2);
----
1	1	6	10	6	2	1.0	0.0
2	2	6	10	10	-1	0.0	1.0

query IIIIIIRR
SELECT * FROM pgr_bdDijkstra((SELECT id, source, target, cost, reverse_cost FROM edges), 6, 12);
----
1	1	6	12	6	4	1.0	0.0
2	2	6	12	7	8	1.0	1.0
3	3	6	12	11	11	1.0	2.0
4	4	6	12	12	-1	0.0	3.0

query IIIIIIRR
SELECT * FROM pgr_bdAstar((SELECT * FROM edges), 6, 12, true, 4, 1, 1);
----
1	1	6	12	6	4	1.0	0.0
2	2	6	12	7	8	1.0	1.0
3	3	6	12	11	11	1.0	2.0
4	4	6	12	12	-1	0.0	3.0

# The three searches agree with pgr_dijkstra on the costs of every pair, for every heuristic
statement ok
CREATE TABLE costs AS SELECT * FROM pgr_dijkstraCostMatrix((SELECT * FROM edges), [1, 3, 5, 6, 7, 8, 9, 10, 11, 12, 15, 16, 17]);

statement ok
SET VARIABLE vids = [1, 3, 5, 6, 7, 8, 9, 10, 11, 12, 15, 16, 17, 2, 99];

foreach heuristic 0 1 2 4 5

query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM pgr_aStar((SELECT * FROM edges), getvariable('vids'), getvariable('vids'), heuristic := ${heuristic}) WHERE edge = -1
	EXCEPT SELECT * FROM costs);
----
0

query I
SELECT count(*) FROM (
	SELECT * FROM costs
	EXCEPT SELECT start_vid, end_vid, agg_cost FROM pgr_bdAstar((SELECT * FROM edges), getvariable('vids'), getvariable('vids'), heuristic := ${heuristic}) WHERE edge = -1);
----
0

endloop

query I
SELECT count(*) FROM (
	(SELECT * FROM costs EXCEPT SELECT start_vid, end_vid, agg_cost FROM pgr_bdDijkstra((SELECT * FROM edges), getvariable('vids'), getvariable('vids')) WHERE edge = -1)
	UNION ALL
	(SELECT start_vid, end_vid, agg_cost FROM pgr_bdDijkstra((SELECT * FROM edges), getvariable('vids'), getvariable('vids')) WHERE edge = -1 EXCEPT SELECT * FROM costs));
----
0

# No rows
query I
SELECT count(*) FROM pgr_aStar((SELECT * FROM edges), 6, [6, 2, 99]);
----
0

query I
SELECT count(*) FROM pgr_bdDijkstra((SELECT * FROM edges), 6, [6, 2, 99]);
----
0

query I
SELECT count(*) FROM pgr_bdAstar((SELECT * FROM edges), [6, 99], [6, 2]);
----
0

query I
SELECT count(*) FROM pgr_bdAstar((SELECT * FROM edges WHERE false), 6, 10);
----
0

# Errors
statement error
SELECT * FROM pgr_aStar((SELECT id, source, target, cost, reverse_cost FROM edges), 6, 12);
----
missing the required column "x1"

statement error
SELECT * FROM pgr_aStar((SELECT * FROM edges), 6, 12, heuristic := 6);
----
unknown heuristic 6

statement error
SELECT * FROM pgr_bdAstar((SELECT * FROM edges), 6, 12, factor := 0);
----
factor must be positive

statement error
SELECT * FROM pgr_aStar((SELECT * FROM edges), 6, 12, epsilon := 0.5);
----
epsilon must be greater than or equal to 1

statement error
SELECT * FROM pgr_bdDijkstra((SELECT * FROM edges), 6, 12, heuristic := 2);
----
heuristic

# Randomized cross-check on a grid with diagonals whose costs are never below the manhattan length of the edges,
# which makes the euclidean and the manhattan heuristics admissible
statement ok
CREATE TABLE grid AS
	SELECT row_number() OVER () AS id, * FROM (
		SELECT x * 20 + y AS source, (x + 1) * 20 + y AS target, x AS x1, y AS y1, x + 1 AS x2, y AS y2 FROM range(19) a(x), range(20) b(y)
		UNION ALL
		SELECT x * 20 + y, x * 20 + y + 1, x, y, x, y + 1 FROM range(20) a(x), range(19) b(y)
		UNION ALL
		SELECT x * 20 + y, (x + 1) * 20 + y + 1, x, y, x + 1, y + 1 FROM range(19) a(x), range(19) b(y) WHERE (x + y) % 3 = 0);

statement ok
CREATE TABLE grid_edges AS SELECT id, source, target, x1, y1, x2, y2,
	(abs(x2 - x1) + abs(y2 - y1)) * (1 + hash(id + 1000) % 4) AS cost,
	CASE WHEN hash(id + 2000) % 4 = 0 THEN -1 ELSE (abs(x2 - x1) + abs(y2 - y1)) * (1 + hash(id + 3000) % 4) END AS reverse_cost
FROM grid;

statement ok
SET VARIABLE starts = (SELECT list(hash(i + 7000) % 400) FROM range(12) t(i));

statement ok
SET VARIABLE ends = (SELECT list(hash(i + 8000) % 400) FROM range(12) t(i));

statement ok
CREATE TABLE grid_costs AS SELECT * FROM pgr_dijkstraCost((SELECT * FROM grid_edges), getvariable('starts'), getvariable('ends'));

query I
SELECT count(*) > 100 FROM grid_costs;
----
true

foreach function pgr_aStar pgr_bdAstar

foreach heuristic 0 4 5

query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM ${function}((SELECT * FROM grid_edges), getvariable('starts'), getvariable('ends'), heuristic := ${heuristic}) WHERE edge = -1) p
FULL JOIN grid_costs c USING (start_vid, end_vid)
WHERE p.agg_cost IS NULL OR c.agg_cost IS NULL OR abs(p.agg_cost - c.agg_cost) > 1e-9;
----
0

endloop

endloop

query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM pgr_bdDijkstra((SELECT * FROM grid_edges), getvariable('starts'), getvariable('ends')) WHERE edge = -1) p
FULL JOIN grid_costs c USING (start_vid, end_vid)
WHERE p.agg_cost IS NULL OR c.agg_cost IS NULL OR abs(p.agg_cost - c.agg_cost) > 1e-9;
----
0

# Undirected
statement ok
CREATE TABLE undirected_costs AS SELECT * FROM pgr_dijkstraCost((SELECT * FROM grid_edges), getvariable('starts'), getvariable('ends'), directed := false);

foreach function pgr_aStar pgr_bdAstar pgr_bdDijkstra

query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM ${function}((SELECT * FROM grid_edges), getvariable('starts'), getvariable('ends'), directed := false) WHERE edge = -1) p
FULL JOIN undirected_costs c USING (start_vid, end_vid)
WHERE p.agg_cost IS NULL OR c.agg_cost IS NULL OR abs(p.agg_cost - c.agg_cost) > 1e-9;
----
0

# The paths are real paths of the graph
query I
SELECT count(*) FROM (
	SELECT p.*, lead(node) OVER w AS next_node, lead(agg_cost) OVER w AS next_agg
	FROM ${function}((SELECT * FROM grid_edges), getvariable('starts'), getvariable('ends')) p
	WINDOW w AS (PARTITION BY start_vid, end_vid ORDER BY path_seq)) p
WHERE edge <> -1 AND (abs(next_agg - agg_cost - cost) > 1e-9 OR NOT EXISTS (
	SELECT 1 FROM grid_edges e WHERE e.id = p.edge
		AND ((e.source = p.node AND e.target = p.next_node AND e.cost = p.cost)
		  OR (e.target = p.node AND e.source = p.next_node AND e.reverse_cost = p.cost))));
----
0

endloop

# A larger epsilon still returns a path, which cannot be shorter than the shortest one
query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM pgr_aStar((SELECT * FROM grid_edges), getvariable('starts'), getvariable('ends'), epsilon := 3) WHERE edge = -1) p
FULL JOIN grid_costs c USING (start_vid, end_vid)
WHERE p.agg_cost IS NULL OR c.agg_cost IS NULL OR p.agg_cost < c.agg_cost - 1e-9;
----
0
