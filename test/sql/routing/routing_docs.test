# name: test/sql/routing/routing_docs.test
# description: Every routing function is registered with its documentation
# group: [routing]

require spatial

query I
SELECT function_name FROM duckdb_functions()
WHERE function_type = 'table' AND tags['category'] = 'routing' ORDER BY lower(function_name);
----
pgr_analyzeGraph
pgr_aStar
pgr_bdAstar
pgr_bdDijkstra
pgr_boykovKolmogorov
pgr_connectedComponents
pgr_createTopology
pgr_dijkstra
pgr_dijkstraCost
pgr_dijkstraCostMatrix
pgr_drivingDistance
pgr_edmondsKarp
pgr_extractVertices
pgr_KSP
pgr_maxFlow
pgr_maxFlowMinCost
pgr_minCostMaxFlow
pgr_nodeNetwork
pgr_pushRelabel
pgr_strongComponents
pgr_trsp
pgr_TSP
pgr_withPoints

query I
SELECT count(*) FROM duckdb_functions()
WHERE function_type = 'table' AND tags['category'] = 'routing'
  AND (tags['ext'] IS DISTINCT FROM 'spatial' OR description IS NULL OR length(description) < 200 OR len(examples) = 0 OR length(examples[1]) < 20);
----
0

# The edges are the only table-valued argument, the other arguments are matched by position or by name
query II
SELECT function_name, parameter_types[1] FROM duckdb_functions()
WHERE function_type = 'table' AND tags['category'] = 'routing' AND parameter_types[1] <> 'TABLE';
----

# The examples of the documentation run
statement ok
CREATE TABLE edges AS SELECT id, source, target, cost::DOUBLE AS cost, reverse_cost::DOUBLE AS reverse_cost, capacity, reverse_capacity,
	x1::DOUBLE AS x1, y1::DOUBLE AS y1, x2::DOUBLE AS x2, y2::DOUBLE AS y2, ST_MakeLine(ST_Point(x1, y1), ST_Point(x2, y2)) AS geom
FROM (VALUES
	(1, 5, 6, 1, 1, 80, 130, 2, 0, 2, 1), (2, 6, 10, -1, 1, -1, 100, 2, 1, 3, 1), (3, 10, 15, -1, 1, -1, 130, 3, 1, 4, 1),
	(4, 6, 7, 1, 1, 100, 50, 2, 1, 2, 2), (5, 10, 11, 1, -1, 130, -1, 3, 1, 3, 2), (6, 1, 3, 1, 1, 50, 100, 0, 2, 1, 2),
	(7, 3, 7, 1, 1, 50, 130, 1, 2, 2, 2), (8, 7, 11, 1, 1, 100, 130, 2, 2, 3, 2), (9, 11, 16, 1, 1, 130, 80, 3, 2, 4, 2),
	(10, 7, 8, 1, 1, 130, 50, 2, 2, 2, 3), (11, 11, 12, 1, -1, 130, -1, 3, 2, 3, 3), (12, 8, 12, 1, -1, 100, -1, 2, 3, 3, 3),
	(13, 12, 17, 1, -1, 100, -1, 3, 3, 4, 3), (14, 8, 9, 1, 1, 80, 130, 2, 3, 2, 4), (15, 16, 17, 1, 1, 80, 50, 4, 2, 4, 3),
	(16, 15, 16, 1, 1, 80, 80, 4, 1, 4, 2), (17, 2, 4, 1, 1, 130, 100, 0.5, 3.5, 1.999999999999, 3.5), (18, 13, 14, 1, 1, 50, 130, 3.5, 2.3, 3.5, 4)
) t(id, source, target, cost, reverse_cost, capacity, reverse_capacity, x1, y1, x2, y2);

statement ok
CREATE TABLE points_of_interest AS SELECT * FROM (VALUES
	(1, 1, 0.4, 'l'), (2, 15, 0.4, 'r'), (3, 12, 0.6, 'l'), (4, 6, 0.3, 'r'), (5, 5, 0.8, 'l'), (6, 4, 0.7, 'b')
) t(pid, edge_id, fraction, side);

statement ok
CREATE TABLE restrictions AS SELECT * FROM (VALUES
	(1, [4, 7], 100), (2, [8, 11], 100), (3, [7, 10], 100), (4, [3, 5, 9], 4), (5, [9, 16], 100)
) t(id, path, cost);

statement ok
