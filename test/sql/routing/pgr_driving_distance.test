# The distance is inclusive
query IIIIIIRR
SELECT * FROM pgr_drivingDistance((SELECT * FROM edges), 5, 1);
----
1	0	5	5	5	-1	0.0	0.0
2	1	5	5	6	1	1.0	1.0

query IIIIIIRR
SELECT * FROM pgr_drivingDistance((SELECT * FROM edges), 5, 0.5);
----
1	0	5	5	5	-1	0.0	0.0

query IIIIIIRR
SELECT * FROM pgr_drivingDistance((SELECT * FROM edges), 5, 0);
----
1	0	5	5	5	-1	0.0	0.0

# Unknown roots are skipped
query I
SELECT count(*) FROM pgr_drivingDistance((SELECT * FROM edges), [98, 99], 10);
----
0

query I
SELECT count(*) FROM pgr_drivingDistance((SELECT * FROM edges), NULL, 10);
----
0

query I
SELECT count(*) FROM pgr_drivingDistance((SELECT * FROM edges WHERE false), 1, 10);
----
0

statement error
SELECT * FROM pgr_drivingDistance((SELECT * FROM edges), 5, -1);
----
distance must be non-negative

statement error
SELECT * FROM pgr_drivingDistance((SELECT * FROM edges), 5, 'far');
----
must be numeric

# Cross-check against pgr_dijkstraCost on a random graph
statement ok
CREATE TABLE random_edges AS SELECT
	i AS id,
	(hash(i + 1000) % 300)::BIGINT AS source,
	(hash(i + 2000) % 300)::BIGINT AS target,
	(1 + hash(i + 3000) % 20)::DOUBLE AS cost,
	CASE WHEN hash(i + 4000) % 3 = 0 THEN -1 ELSE 1 + hash(i + 5000) % 20 END::DOUBLE AS reverse_cost
FROM range(1, 1201) t(i);

statement ok
SET VARIABLE everything = (SELECT list(i) FROM range(300) t(i));

statement ok
CREATE TABLE reached AS SELECT * FROM pgr_drivingDistance((SELECT * FROM random_edges), [7, 42, 250], 30);

query I
SELECT count(*) > 100 FROM reached;
----
true

query I
SELECT count(*) FROM (
	(SELECT start_vid, node, agg_cost FROM reached WHERE start_vid <> node
	 EXCEPT SELECT * FROM pgr_dijkstraCost((SELECT * FROM random_edges), [7, 42, 250], getvariable('everything')) WHERE agg_cost <= 30)
	UNION ALL
	(SELECT * FROM pgr_dijkstraCost((SELECT * FROM random_edges), [7, 42, 250], getvariable('everything')) WHERE agg_cost <= 30
	 EXCEPT SELECT start_vid, node, agg_cost FROM reached));
----
0

# The rows describe a tree: the predecessor is one level up, and the edge leads from it to the node
query I
SELECT count(*) FROM reached r
WHERE r.node <> r.start_vid AND NOT EXISTS (
	SELECT 1 FROM reached p JOIN random_edges e ON e.id = r.edge
	WHERE p.start_vid = r.start_vid AND p.node = r.pred AND p.depth = r.depth - 1 AND p.agg_cost + r.cost = r.agg_cost
	  AND ((e.source = r.pred AND e.target = r.node AND e.cost = r.cost) OR (e.target = r.pred AND e.source = r.node AND e.reverse_cost = r.cost)));
----
0

query IIIIRR
SELECT depth, pred = start_vid, node = start_vid, edge, cost, agg_cost FROM reached WHERE depth = 0 ORDER BY start_vid;
----
0	true	true	-1	0.0	0.0
0	true	true	-1	0.0	0.0
0	true	true	-1	0.0	0.0

query I
SELECT count(*) FROM (SELECT seq - row_number() OVER (ORDER BY start_vid, depth, node) AS d FROM reached) WHERE d <> 0;
----
0

# With equicost every node is kept by its nearest root only
statement ok
CREATE TABLE nearest AS SELECT * FROM pgr_drivingDistance((SELECT * FROM random_edges), [7, 42, 250], 30, equicost := true);

query I
SELECT count(*) FROM (SELECT node FROM nearest GROUP BY node HAVING count(*) > 1);
----
0

query I
SELECT count(*) FROM (
	(SELECT node, min(agg_cost) FROM reached GROUP BY node EXCEPT SELECT node, agg_cost FROM nearest)
	UNION ALL
	(SELECT node, agg_cost FROM nearest EXCEPT SELECT node, min(agg_cost) FROM reached GROUP BY node));
----
0
