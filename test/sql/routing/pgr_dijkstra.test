# The start and end vertices have to be constants
statement error
SELECT * FROM range(3) r(i), LATERAL pgr_dijkstra((SELECT * FROM edges), r.i, 10);
----

# Without the optimizer the input is not materialized first: an input that comes from one pipeline still works,
# an input that arrives in several parts is refused instead of being routed on partially
statement ok
PRAGMA disable_optimizer;

query II
SELECT node, edge FROM pgr_dijkstra((SELECT * FROM edges), 6, 10, false);
----
6	2
10	-1

statement error
SELECT * FROM pgr_dijkstraCost((SELECT * FROM edges WHERE id <= 9 UNION ALL SELECT * FROM edges WHERE id > 9), 6, 10);
----
arrived in several parts

statement ok
PRAGMA enable_optimizer;

# Errors
statement error
SELECT * FROM pgr_dijkstra((SELECT id, source, target FROM edges), 6, 10);
----
missing the required column "cost"

statement error
SELECT * FROM pgr_dijkstra((SELECT id::VARCHAR AS id, source, target, cost FROM edges), 6, 10);
----
column "id" of the edges input must be of an integer type, but it is of type VARCHAR

statement error
SELECT * FROM pgr_dijkstra((SELECT id, source, target, 'a' AS cost FROM edges), 6, 10);
----
column "cost" of the edges input must be of a numeric type

statement error
SELECT * FROM pgr_dijkstra((SELECT id, source, NULL::BIGINT AS target, cost FROM edges), 6, 10);
----
unexpected NULL value in column "target"

statement error
SELECT * FROM pgr_dijkstra((SELECT id, source, target, cost, NULL::DOUBLE AS reverse_cost FROM edges), 6, 10);
----
unexpected NULL value in column "reverse_cost"

statement error
SELECT * FROM pgr_dijkstra((SELECT * FROM edges), 6, 'a');
----
must be an integer or a list of integers

statement error
SELECT * FROM pgr_dijkstra((SELECT * FROM edges), 6, [1.5]);
----
must be an integer or a list of integers

statement error
SELECT * FROM pgr_dijkstra((SELECT * FROM edges), 6, 10, true, true);
----
too many arguments

statement error
SELECT * FROM pgr_dijkstra((SELECT * FROM edges), 6);
----

statement error
SELECT * FROM pgr_dijkstra('SELECT * FROM edges', 6, 10);
----

statement error
SELECT * FROM pgr_dijkstraCostMatrix((SELECT * FROM edges), (SELECT [1, 2]));
----
at most one subquery parameter

# Cross-check against an all-pairs reference computed in SQL on a random graph
statement ok
CREATE TABLE random_edges AS SELECT
	i AS id,
	(hash(i + 1000) % 50)::BIGINT AS source,
	(hash(i + 2000) % 50)::BIGINT AS target,
	(1 + hash(i + 3000) % 20)::DOUBLE AS cost,
	CASE WHEN hash(i + 4000) % 3 = 0 THEN -1 ELSE 1 + hash(i + 5000) % 20 END::DOUBLE AS reverse_cost
FROM range(1, 161) t(i);

statement ok
CREATE TABLE arcs AS
	SELECT id, source AS u, target AS v, cost AS c FROM random_edges WHERE cost >= 0
	UNION ALL
	SELECT id, target, source, reverse_cost FROM random_edges WHERE reverse_cost >= 0;

statement ok
CREATE TABLE reference AS
	SELECT u, v, min(c) AS c FROM (SELECT u, v, c FROM arcs UNION ALL SELECT i, i, 0 FROM range(50) t(i)) GROUP BY ALL;

# Min-plus squaring: six rounds cover every path of up to 64 edges
loop i 0 6

statement ok
CREATE OR REPLACE TABLE reference AS
	SELECT a.u, b.v, min(a.c + b.c) AS c FROM reference a JOIN reference b ON a.v = b.u GROUP BY ALL;

endloop

statement ok
SET VARIABLE everything = (SELECT list(i) FROM range(50) t(i));

query I
SELECT count(*) > 1000 FROM reference WHERE u <> v;
----
true

query I
SELECT count(*) FROM (
	(SELECT u, v, c FROM reference WHERE u <> v AND u IN (SELECT u FROM arcs UNION SELECT v FROM arcs)
	                                        AND v IN (SELECT u FROM arcs UNION SELECT v FROM arcs)
	 EXCEPT SELECT * FROM pgr_dijkstraCostMatrix((SELECT * FROM random_edges), getvariable('everything')))
	UNION ALL
	(SELECT * FROM pgr_dijkstraCostMatrix((SELECT * FROM random_edges), getvariable('everything'))
	 EXCEPT SELECT u, v, c FROM reference));
----
0

# Many sources to few targets takes the reversed search, few to many the forward one: both agree with the reference
query I
SELECT count(*) FROM (
	SELECT * FROM pgr_dijkstraCost((SELECT * FROM random_edges), getvariable('everything'), [3, 17])
	EXCEPT SELECT u, v, c FROM reference);
----
0

query I
SELECT count(*) FROM (
	SELECT * FROM pgr_dijkstraCost((SELECT * FROM random_edges), [3, 17], getvariable('everything'))
	EXCEPT SELECT u, v, c FROM reference);
----
0

# Every returned path is a real path of the graph whose cost is the reference cost
statement ok
CREATE TABLE paths AS SELECT * FROM pgr_dijkstra((SELECT * FROM random_edges), getvariable('everything'), [3, 17, 28]);

query I
SELECT count(*) > 50 FROM paths WHERE edge = -1;
----
true

query I
SELECT count(*) FROM paths p JOIN reference r ON r.u = p.start_vid AND r.v = p.end_vid WHERE p.edge = -1 AND p.agg_cost <> r.c;
----
0

query I
SELECT count(*) FROM (
	SELECT p.*, lead(node) OVER w AS next_node, lead(agg_cost) OVER w AS next_agg FROM paths p
	WINDOW w AS (PARTITION BY start_vid, end_vid ORDER BY path_seq)) p
WHERE edge <> -1 AND (next_agg <> agg_cost + cost
	OR NOT EXISTS (SELECT 1 FROM arcs a WHERE a.id = p.edge AND a.u = p.node AND a.v = p.next_node AND a.c = p.cost));
----
0

query I
SELECT count(*) FROM (
	SELECT seq - row_number() OVER (ORDER BY start_vid, end_vid, path_seq) AS d,
	       path_seq - row_number() OVER (PARTITION BY start_vid, end_vid ORDER BY seq) AS e FROM paths) WHERE d <> 0 OR e <> 0;
----
0

# The undirected graph uses every edge both ways
statement ok
CREATE TABLE undirected_reference AS
	SELECT u, v, min(c) AS c FROM (
		SELECT u, v, c FROM arcs UNION ALL SELECT v, u, c FROM arcs UNION ALL SELECT i, i, 0 FROM range(50) t(i)) GROUP BY ALL;

loop i 0 6

statement ok
CREATE OR REPLACE TABLE undirected_reference AS
	SELECT a.u, b.v, min(a.c + b.c) AS c FROM undirected_reference a JOIN undirected_reference b ON a.v = b.u GROUP BY ALL;

endloop

query I
SELECT count(*) FROM (
	SELECT * FROM pgr_dijkstraCostMatrix((SELECT * FROM random_edges), getvariable('everything'), directed := false)
	EXCEPT SELECT u, v, c FROM undirected_reference);
----
0

# A large input arrives in many chunks
query IIR
SELECT count(*), max(node), max(agg_cost)::BIGINT FROM pgr_dijkstra((
	SELECT i AS id, i AS source, i + 1 AS target, 1 AS cost FROM range(100000) t(i)), 0, 100000);
----
100001	100000	100000
