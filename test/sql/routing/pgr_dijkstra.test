# name: test/sql/routing/pgr_dijkstra.test
# description: Test pgr_dijkstra, pgr_dijkstraCost and pgr_dijkstraCostMatrix
# group: [routing]

require spatial

# The pgRouting sample graph
statement ok
CREATE TABLE edges AS SELECT * FROM (VALUES
	(1, 5, 6, 1, 1), (2, 6, 10, -1, 1), (3, 10, 15, -1, 1), (4, 6, 7, 1, 1), (5, 10, 11, 1, -1), (6, 1, 3, 1, 1),
	(7, 3, 7, 1, 1), (8, 7, 11, 1, 1), (9, 11, 16, 1, 1), (10, 7, 8, 1, 1), (11, 11, 12, 1, -1), (12, 8, 12, 1, -1),
	(13, 12, 17, 1, -1), (14, 8, 9, 1, 1), (15, 16, 17, 1, 1), (16, 15, 16, 1, 1), (17, 2, 4, 1, 1), (18, 13, 14, 1, 1)
) t(id, source, target, cost, reverse_cost);

# One to one
query IIIIIIRR
SELECT * FROM pgr_dijkstra((SELECT id, source, target, cost, reverse_cost FROM edges), 6, 10);
----
1	1	6	10	6	4	1.0	0.0
2	2	6	10	7	8	1.0	1.0
3	3	6	10	11	9	1.0	2.0
4	4	6	10	16	16	1.0	3.0
5	5	6	10	15	3	1.0	4.0
6	6	6	10	10	-1	0.0	5.0

# The direction can be passed positionally, as in pgRouting
query IIIIIIRR
SELECT * FROM pgr_dijkstra((SELECT id, source, target, cost, reverse_cost FROM edges), 6, 10, false);
----
1	1	6	10	6	2	1.0	0.0
2	2	6	10	10	-1	0.0	1.0

# One to many
query IIIIIIRR
SELECT * FROM pgr_dijkstra((SELECT id, source, target, cost, reverse_cost FROM edges), 6, [10, 17]);
----
1	1	6	10	6	4	1.0	0.0
2	2	6	10	7	8	1.0	1.0
3	3	6	10	11	9	1.0	2.0
4	4	6	10	16	16	1.0	3.0
5	5	6	10	15	3	1.0	4.0
6	6	6	10	10	-1	0.0	5.0
7	1	6	17	6	4	1.0	0.0
8	2	6	17	7	10	1.0	1.0
9	3	6	17	8	12	1.0	2.0
10	4	6	17	12	13	1.0	3.0
11	5	6	17	17	-1	0.0	4.0

# Many to one
query IIIIIIRR
SELECT * FROM pgr_dijkstra((SELECT id, source, target, cost, reverse_cost FROM edges), [6, 1], 17);
----
1	1	1	17	1	6	1.0	0.0
2	2	1	17	3	7	1.0	1.0
3	3	1	17	7	10	1.0	2.0
4	4	1	17	8	12	1.0	3.0
5	5	1	17	12	13	1.0	4.0
6	6	1	17	17	-1	0.0	5.0
7	1	6	17	6	4	1.0	0.0
8	2	6	17	7	10	1.0	1.0
9	3	6	17	8	12	1.0	2.0
10	4	6	17	12	13	1.0	3.0
11	5	6	17	17	-1	0.0	4.0

# Many to many on an undirected graph, duplicates are ignored
query IIIIIIRR
SELECT * FROM pgr_dijkstra((SELECT id, source, target, cost, reverse_cost FROM edges), [6, 1, 6], [10, 17, 10], directed := false);
----
1	1	1	10	1	6	1.0	0.0
2	2	1	10	3	7	1.0	1.0
3	3	1	10	7	4	1.0	2.0
4	4	1	10	6	2	1.0	3.0
5	5	1	10	10	-1	0.0	4.0
6	1	1	17	1	6	1.0	0.0
7	2	1	17	3	7	1.0	1.0
8	3	1	17	7	10	1.0	2.0
9	4	1	17	8	12	1.0	3.0
10	5	1	17	12	13	1.0	4.0
11	6	1	17	17	-1	0.0	5.0
12	1	6	10	6	2	1.0	0.0
13	2	6	10	10	-1	0.0	1.0
14	1	6	17	6	4	1.0	0.0
15	2	6	17	7	10	1.0	1.0
16	3	6	17	8	12	1.0	2.0
17	4	6	17	12	13	1.0	3.0
18	5	6	17	17	-1	0.0	4.0

# Without reverse_cost the edges are one way
query III
SELECT path_seq, node, edge FROM pgr_dijkstra((SELECT id, source, target, cost FROM edges), 6, 10);
----

query III
SELECT path_seq, node, edge FROM pgr_dijkstra((SELECT id, source, target, cost FROM edges), 5, 17);
----
1	5	1
2	6	4
3	7	10
4	8	12
5	12	13
6	17	-1

# The columns are matched by name, whatever their order and type
query III
SELECT path_seq, node, edge FROM pgr_dijkstra((
	SELECT cost::DECIMAL(10, 2) AS cost, 'x' AS ignored, target::SMALLINT AS target, source::UBIGINT AS source, id::HUGEINT AS ID FROM edges), 5, 17);
----
1	5	1
2	6	4
3	7	10
4	8	12
5	12	13
6	17	-1

# The result does not depend on the order of the rows
query I
SELECT count(*) FROM (
	SELECT * FROM pgr_dijkstra((SELECT * FROM edges ORDER BY id DESC), [1, 5, 9], [10, 15, 17])
	EXCEPT
	SELECT * FROM pgr_dijkstra((SELECT * FROM edges ORDER BY hash(id)), [1, 5, 9], [10, 15, 17]));
----
0

# No rows: same start and end, unreachable, unknown vertices, empty graph, NULL arguments
query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges), 6, 6);
----
0

query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges), 6, 2);
----
0

query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges), 6, 99);
----
0

query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges), 99, [6, 7]);
----
0

query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges WHERE false), 6, 10);
----
0

query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges), NULL, 10);
----
0

query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges), 6, []);
----
0

query I
SELECT count(*) FROM pgr_dijkstra((SELECT * FROM edges), 6, 10, directed := NULL);
----
0

# Parallel edges, self loops, zero costs, and vertex identifiers that need 64 bits
statement ok
CREATE TABLE odd AS SELECT * FROM (VALUES
	(1, -9000000000000000000, 5, 4.0, 4.0),
	(2, -9000000000000000000, 5, 2.5, -1.0),
	(3, 5, 5, 0.0, 0.0),
	(4, 5, 9000000000000000000, 0.0, -1.0),
	(5, 9000000000000000000, -9000000000000000000, 1.5, -1.0)
) t(id, source, target, cost, reverse_cost);

query IIIIIITT
SELECT * REPLACE (cost::VARCHAR AS cost, agg_cost::VARCHAR AS agg_cost) FROM pgr_dijkstra((SELECT * FROM odd), -9000000000000000000, 9000000000000000000);
----
1	1	-9000000000000000000	9000000000000000000	-9000000000000000000	2	2.5	0.0
2	2	-9000000000000000000	9000000000000000000	5	4	0.0	2.5
3	3	-9000000000000000000	9000000000000000000	9000000000000000000	-1	0.0	2.5

query IIIIIITT
SELECT * REPLACE (cost::VARCHAR AS cost, agg_cost::VARCHAR AS agg_cost) FROM pgr_dijkstra((SELECT * FROM odd), 5, -9000000000000000000);
----
1	1	5	-9000000000000000000	5	4	0.0	0.0
2	2	5	-9000000000000000000	9000000000000000000	5	1.5	0.0
3	3	5	-9000000000000000000	-9000000000000000000	-1	0.0	1.5

# The function runs inside the calling transaction and reads CTEs, temporary tables and uncommitted rows
query IIT
WITH shortcut AS (SELECT * FROM edges UNION ALL SELECT 99, 6, 10, 0.5, -1)
SELECT node, edge, cost::VARCHAR FROM pgr_dijkstra((SELECT * FROM shortcut), 6, 10);
----
6	99	0.5
10	-1	0.0

# An input that is produced by several pipelines is seen in full before the search starts
query IIR
SELECT * FROM pgr_dijkstraCost((
	SELECT * FROM edges WHERE id <= 6
	UNION ALL SELECT * FROM edges WHERE id BETWEEN 7 AND 12
	UNION ALL SELECT * FROM edges WHERE id > 12), [6, 1], [10, 17]);
----
1	10	6.0
1	17	5.0
6	10	5.0
6	17	4.0

query I
SELECT count(*) FROM (
	SELECT * FROM pgr_dijkstra((SELECT e.* FROM edges e JOIN range(1, 19) r(i) ON e.id = r.i ORDER BY e.id DESC), 6, [10, 17])
	EXCEPT SELECT * FROM pgr_dijkstra((SELECT * FROM edges), 6, [10, 17]));
----
0

statement ok
BEGIN;

statement ok
CREATE TEMPORARY TABLE scratch AS SELECT * FROM edges WHERE id <> 8;

statement ok
INSERT INTO scratch VALUES (100, 7, 10, 1, 1);

query III
SELECT node, edge, cost FROM pgr_dijkstra((SELECT * FROM scratch), 6, 10);
----
6	4	1.0
7	100	1.0
10	-1	0.0

statement ok
ROLLBACK;

# Start and end vertices can come from a prepared statement parameter or a variable
statement ok
PREPARE route AS SELECT node FROM pgr_dijkstra((SELECT * FROM edges), $1, $2);

query I
EXECUTE route(6, 10);
----
6
7
11
16
15
10

statement ok
SET VARIABLE targets = (SELECT list(id) FROM range(15, 18) t(id));

query III
SELECT start_vid, end_vid, max(agg_cost) FROM pgr_dijkstra((SELECT * FROM edges), 6, getvariable('targets')) GROUP BY ALL ORDER BY ALL;
----
6	15	4.0
6	16	3.0
6	17	4.0

# The result can be filtered, joined and aggregated like any table
query IR
SELECT e.id, p.agg_cost FROM pgr_dijkstra((SELECT * FROM edges), 6, 10) p JOIN edges e ON e.id = p.edge WHERE p.path_seq > 2 ORDER BY p.seq;
----
9	2.0
16	3.0
3	4.0

