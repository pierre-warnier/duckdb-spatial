# The driving side can be named, and both sides can be allowed
query IIR
SELECT start_vid, end_vid, round(max(agg_cost), 6)
FROM pgr_withPoints((SELECT * FROM edges), getvariable('points'), [-1, -4, -6], [-2, -5, 3], driving_side := 'b') GROUP BY ALL ORDER BY ALL;
----
-6	-5	5.1
-6	-2	2.7
-6	3	1.3
-4	-5	6.5
-4	-2	4.1
-4	3	0.7
-1	-5	6.4
-1	-2	4.0
-1	3	2.6

# The points can be given inline; the identifier and the side are optional
query IIIRR
SELECT path_seq, node, edge, cost, agg_cost
FROM pgr_withPoints((SELECT * FROM edges), [{'edge_id': 7, 'fraction': 0.25}, {'edge_id': 9, 'fraction': 0.5}], -1, -2, details := true);
----
1	-1	7	0.75	0.0
2	7	8	1.0	0.75
3	11	9	0.5	1.75
4	-2	-1	0.0	2.25

# A point at the very start or end of an edge
query IIIRR
SELECT path_seq, node, edge, cost, agg_cost
FROM pgr_withPoints((SELECT * FROM edges), [{'pid': 1, 'edge_id': 7, 'fraction': 0.0}, {'pid': 2, 'edge_id': 9, 'fraction': 1.0}], -1, -2, details := true);
----
1	-1	7	1.0	0.0
2	7	8	1.0	1.0
3	11	9	1.0	2.0
4	-2	-1	0.0	3.0

# Two points on the same edge
query IIIRR
SELECT path_seq, node, edge, cost, agg_cost
FROM pgr_withPoints((SELECT * FROM edges), [{'pid': 1, 'edge_id': 7, 'fraction': 0.75}, {'pid': 2, 'edge_id': 7, 'fraction': 0.25}], -1, -2, 'b');
----
1	-1	7	0.5	0.0
2	-2	-1	0.0	0.5

# Without points, or with points on unknown edges, the result is the one of pgr_dijkstra
query I
SELECT count(*) FROM (
	SELECT * FROM pgr_withPoints((SELECT * FROM edges), [], [6, 1], [10, 17])
	EXCEPT SELECT * FROM pgr_dijkstra((SELECT * FROM edges), [6, 1], [10, 17]));
----
0

query I
SELECT count(*) FROM (
	SELECT * FROM pgr_dijkstra((SELECT * FROM edges), [6, 1], [10, 17])
	EXCEPT SELECT * FROM pgr_withPoints((SELECT * FROM edges), [{'pid': 1, 'edge_id': 999, 'fraction': 0.5}], [6, 1], [10, 17]));
----
0

# No rows: unknown point, same point, NULL arguments
query I
SELECT count(*) FROM pgr_withPoints((SELECT * FROM edges), getvariable('points'), -9, 10);
----
0

query I
SELECT count(*) FROM pgr_withPoints((SELECT * FROM edges), getvariable('points'), -1, -1);
----
0

query I
SELECT count(*) FROM pgr_withPoints((SELECT * FROM edges), NULL, -1, 10);
----
0

# Errors
statement error
SELECT * FROM pgr_withPoints((SELECT * FROM edges), getvariable('points'), -1, 10, 'x');
----
invalid driving side 'x'

statement error
SELECT * FROM pgr_withPoints((SELECT * FROM edges), [{'pid': 1, 'edge_id': 7, 'fraction': 1.5}], -1, 10);
----
the fraction of point 1 must be between 0 and 1

statement error
SELECT * FROM pgr_withPoints((SELECT * FROM edges), [{'pid': 1, 'edge_id': 7, 'fraction': 0.5, 'side': 'x'}], -1, 10);
----
invalid point side 'x'

statement error
SELECT * FROM pgr_withPoints((SELECT * FROM edges), [{'pid': 1, 'edge_id': 7, 'fraction': 0.5}, {'pid': 1, 'edge_id': 8, 'fraction': 0.5}], -1, 10);
----
point 1 is given with different edge, fraction or side values

statement error
SELECT * FROM pgr_withPoints((SELECT * FROM edges), [{'pid': 1, 'fraction': 0.5}], -1, 10);
----
the points need the fields "edge_id" and "fraction"

statement error
SELECT * FROM pgr_withPoints((SELECT * FROM edges), [1, 2], -1, 10);
----
must be a list of structs

statement error
SELECT * FROM pgr_withPoints((SELECT * FROM edges), (SELECT list(p) FROM points_of_interest p), -1, 10);
----
at most one subquery parameter

# Cross-check: a point in the middle of an edge is a vertex of a graph where that edge is split by hand
statement ok
CREATE TABLE random_edges AS SELECT
	i AS id,
	(hash(i + 1000) % 40)::BIGINT AS source,
	(hash(i + 2000) % 40)::BIGINT AS target,
	(1 + hash(i + 3000) % 20)::DOUBLE AS cost,
	CASE WHEN hash(i + 4000) % 3 = 0 THEN -1 ELSE 1 + hash(i + 5000) % 20 END::DOUBLE AS reverse_cost
FROM range(1, 121) t(i);

statement ok
CREATE TABLE random_points AS SELECT i AS pid, 3 * i + 1 AS edge_id, 0.25 AS fraction FROM range(1, 9, 2) t(i)
	UNION ALL SELECT i, 10 * i, 0.5 FROM range(2, 9, 2) t(i);

# Split edges: the edge (source, target) becomes (source, -pid) and (-pid, target), costs shared by the fraction
statement ok
CREATE TABLE split_edges AS
	SELECT e.* FROM random_edges e WHERE e.id NOT IN (SELECT edge_id FROM random_points)
	UNION ALL
	SELECT e.id, e.source, -p.pid, CASE WHEN e.cost < 0 THEN -1 ELSE e.cost * p.fraction END,
	       CASE WHEN e.reverse_cost < 0 THEN -1 ELSE e.reverse_cost * p.fraction END
	FROM random_edges e JOIN random_points p ON p.edge_id = e.id
	UNION ALL
	SELECT e.id, -p.pid, e.target, CASE WHEN e.cost < 0 THEN -1 ELSE e.cost * (1 - p.fraction) END,
	       CASE WHEN e.reverse_cost < 0 THEN -1 ELSE e.reverse_cost * (1 - p.fraction) END
	FROM random_edges e JOIN random_points p ON p.edge_id = e.id;

query I
SELECT count(DISTINCT edge_id) FROM random_points;
----
8

statement ok
SET VARIABLE random_points = (SELECT list(p) FROM random_points p);

statement ok
SET VARIABLE stops = [-1, -2, -3, -4, -5, -6, -7, -8, 0, 7, 21, 39];

query I
SELECT count(*) > 20 FROM pgr_withPoints((SELECT * FROM random_edges), getvariable('random_points'), getvariable('stops'), getvariable('stops'), 'b', details := true) WHERE edge = -1;
----
true

query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM pgr_withPoints((SELECT * FROM random_edges), getvariable('random_points'), getvariable('stops'), getvariable('stops'), 'b', details := true) WHERE edge = -1) p
FULL JOIN pgr_dijkstraCost((SELECT * FROM split_edges), getvariable('stops'), getvariable('stops')) c USING (start_vid, end_vid)
WHERE p.agg_cost IS NULL OR c.agg_cost IS NULL OR abs(p.agg_cost - c.agg_cost) > 1e-9;
----
0

# Same on the undirected graph, where the driving side does not matter
query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM pgr_withPoints((SELECT * FROM random_edges), getvariable('random_points'), getvariable('stops'), getvariable('stops'), 'r', directed := false) WHERE edge = -1) p
FULL JOIN pgr_dijkstraCost((SELECT * FROM split_edges), getvariable('stops'), getvariable('stops'), directed := false) c USING (start_vid, end_vid)
WHERE p.agg_cost IS NULL OR c.agg_cost IS NULL OR abs(p.agg_cost - c.agg_cost) > 1e-9;
----
0

# Without details the total cost of every path is unchanged
query I
SELECT count(*) FROM (
	SELECT start_vid, end_vid, agg_cost FROM pgr_withPoints((SELECT * FROM random_edges), getvariable('random_points'), getvariable('stops'), getvariable('stops'), 'r') WHERE edge = -1) p
FULL JOIN (
	SELECT start_vid, end_vid, agg_cost FROM pgr_withPoints((SELECT * FROM random_edges), getvariable('random_points'), getvariable('stops'), getvariable('stops'), 'r', details := true) WHERE edge = -1) d
USING (start_vid, end_vid)
WHERE p.agg_cost IS NULL OR d.agg_cost IS NULL OR abs(p.agg_cost - d.agg_cost) > 1e-9;
----
0
