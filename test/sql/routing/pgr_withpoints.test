# name: test/sql/routing/pgr_withpoints.test
# description: Test pgr_withPoints
# group: [routing]

require spatial

# The pgRouting sample graph and points of interest
statement ok
CREATE TABLE edges AS SELECT * FROM (VALUES
	(1, 5, 6, 1, 1), (2, 6, 10, -1, 1), (3, 10, 15, -1, 1), (4, 6, 7, 1, 1), (5, 10, 11, 1, -1), (6, 1, 3, 1, 1),
	(7, 3, 7, 1, 1), (8, 7, 11, 1, 1), (9, 11, 16, 1, 1), (10, 7, 8, 1, 1), (11, 11, 12, 1, -1), (12, 8, 12, 1, -1),
	(13, 12, 17, 1, -1), (14, 8, 9, 1, 1), (15, 16, 17, 1, 1), (16, 15, 16, 1, 1), (17, 2, 4, 1, 1), (18, 13, 14, 1, 1)
) t(id, source, target, cost, reverse_cost);

statement ok
CREATE TABLE points_of_interest AS SELECT * FROM (VALUES
	(1, 1, 0.4, 'l'), (2, 15, 0.4, 'r'), (3, 12, 0.6, 'l'), (4, 6, 0.3, 'r'), (5, 5, 0.8, 'l'), (6, 4, 0.7, 'b')
) t(pid, edge_id, fraction, side);

statement ok
SET VARIABLE points = (SELECT list(p) FROM points_of_interest p);

# The queries of the pgRouting documentation, with the same results.
# From point 1 to vertex 10, right side driving (the default on a directed graph), with details
query IIIIIIRR
SELECT seq, path_seq, start_vid, end_vid, node, edge, round(cost, 6), round(agg_cost, 6)
FROM pgr_withPoints((SELECT id, source, target, cost, reverse_cost FROM edges), getvariable('points'), -1, 10, details := true);
----
1	1	-1	10	-1	1	0.4	0.0
2	2	-1	10	5	1	1.0	0.4
3	3	-1	10	6	4	0.7	1.4
4	4	-1	10	-6	4	0.3	2.1
5	5	-1	10	7	8	1.0	2.4
6	6	-1	10	11	9	1.0	3.4
7	7	-1	10	16	16	1.0	4.4
8	8	-1	10	15	3	1.0	5.4
9	9	-1	10	10	-1	0.0	6.4

# From point 1 to point 3 and vertex 7 on an undirected graph
query IIIIIIRR
SELECT seq, path_seq, start_vid, end_vid, node, edge, round(cost, 6), round(agg_cost, 6)
FROM pgr_withPoints((SELECT * FROM edges), getvariable('points'), -1, [-3, 7], directed := false);
