# name: test/sql/routing/pgr_ksp.test
# description: Test pgr_KSP
# group: [routing]

require spatial

# The pgRouting sample graph
statement ok
CREATE TABLE edges AS SELECT * FROM (VALUES
	(1, 5, 6, 1, 1), (2, 6, 10, -1, 1), (3, 10, 15, -1, 1), (4, 6, 7, 1, 1), (5, 10, 11, 1, -1), (6, 1, 3, 1, 1),
	(7, 3, 7, 1, 1), (8, 7, 11, 1, 1), (9, 11, 16, 1, 1), (10, 7, 8, 1, 1), (11, 11, 12, 1, -1), (12, 8, 12, 1, -1),
	(13, 12, 17, 1, -1), (14, 8, 9, 1, 1), (15, 16, 17, 1, 1), (16, 15, 16, 1, 1), (17, 2, 4, 1, 1), (18, 13, 14, 1, 1)
) t(id, source, target, cost, reverse_cost);

# There are three paths of cost 4 from 6 to 17, returned in node order
query IIIIIIIRR
SELECT * FROM pgr_KSP((SELECT id, source, target, cost, reverse_cost FROM edges), 6, 17, 3);
----
1	1	1	6	17	6	4	1.0	0.0
2	1	2	6	17	7	10	1.0	1.0
3	1	3	6	17	8	12	1.0	2.0
4	1	4	6	17	12	13	1.0	3.0
5	1	5	6	17	17	-1	0.0	4.0
6	2	1	6	17	6	4	1.0	0.0
7	2	2	6	17	7	8	1.0	1.0
8	2	3	6	17	11	11	1.0	2.0
9	2	4	6	17	12	13	1.0	3.0
10	2	5	6	17	17	-1	0.0	4.0
11	3	1	6	17	6	4	1.0	0.0
12	3	2	6	17	7	8	1.0	1.0
13	3	3	6	17	11	9	1.0	2.0
14	3	4	6	17	16	15	1.0	3.0
15	3	5	6	17	17	-1	0.0	4.0

# The path identifiers keep increasing over the pairs
query IIIIIR
SELECT path_id, start_vid, end_vid, count(*), string_agg(node::VARCHAR, '-' ORDER BY path_seq), max(agg_cost)::VARCHAR
FROM pgr_KSP((SELECT * FROM edges), [6, 1], [10, 17], 2) GROUP BY ALL ORDER BY path_id;
----
1	1	10	7	1-3-7-11-16-15-10	6.0
2	1	10	9	1-3-7-8-12-17-16-15-10	8.0
3	1	17	6	1-3-7-8-12-17	5.0
4	1	17	6	1-3-7-11-12-17	5.0
5	6	10	6	6-7-11-16-15-10	5.0
6	6	10	8	6-7-8-12-17-16-15-10	7.0
7	6	17	5	6-7-8-12-17	4.0
8	6	17	5	6-7-11-12-17	4.0

# More paths requested than there are
query IIR
SELECT path_id, string_agg(node::VARCHAR, '-' ORDER BY path_seq), max(agg_cost)::VARCHAR
FROM pgr_KSP((SELECT * FROM edges), 1, 6, 10) GROUP BY ALL ORDER BY path_id;
----
1	1-3-7-6	3.0
2	1-3-7-11-16-15-10-6	7.0
3	1-3-7-8-12-17-16-15-10-6	9.0
4	1-3-7-11-12-17-16-15-10-6	9.0

query IIR
SELECT path_id, string_agg(node::VARCHAR, '-' ORDER BY path_seq), max(agg_cost)::VARCHAR
FROM pgr_KSP((SELECT * FROM edges), 6, 17, 2, directed := false, heap_paths := true) GROUP BY ALL ORDER BY path_id;
----
1	6-7-8-12-17	4.0
2	6-7-11-12-17	4.0
3	6-10-11-12-17	4.0
4	6-7-8-12-11-16-17	6.0

# Parallel edges give distinct paths
query IIIR
SELECT path_id, path_seq, edge, agg_cost::VARCHAR FROM pgr_KSP((SELECT * FROM (VALUES (1, 1, 2, 5.0), (2, 1, 2, 3.0), (3, 2, 3, 1.0), (4, 2, 3, 1.0)) t(id, source, target, cost)), 1, 3, 10);
----
1	1	2	0.0
1	2	3	3.0
1	3	-1	4.0
2	1	2	0.0
2	2	4	3.0
2	3	-1	4.0
3	1	1	0.0
3	2	3	5.0
3	3	-1	6.0
4	1	1	0.0
4	2	4	5.0
4	3	-1	6.0

# No rows
query I
SELECT count(*) FROM pgr_KSP((SELECT * FROM edges), 6, 17, 0);
----
0

query I
SELECT count(*) FROM pgr_KSP((SELECT * FROM edges), 6, [6, 2, 99], 3);
----
0

query I
SELECT count(*) FROM pgr_KSP((SELECT * FROM edges), 6, 17, NULL);
----
0

statement error
SELECT * FROM pgr_KSP((SELECT * FROM edges), 6, 17, -1);
----
K must be non-negative

statement error
SELECT * FROM pgr_KSP((SELECT * FROM edges), 6, 17);
----

# Cross-check against every simple path of a small random graph, enumerated with a recursive CTE
statement ok
CREATE TABLE random_edges AS SELECT
	i AS id,
	(hash(i + 1000) % 8)::BIGINT AS source,
	(hash(i + 2000) % 8)::BIGINT AS target,
	(1 + hash(i + 3000) % 20)::DOUBLE AS cost,
	CASE WHEN hash(i + 4000) % 3 = 0 THEN -1 ELSE 1 + hash(i + 5000) % 20 END::DOUBLE AS reverse_cost
FROM range(1, 31) t(i);

statement ok
CREATE TABLE arcs AS
	SELECT id, source AS u, target AS v, cost AS c FROM random_edges WHERE cost >= 0 AND source <> target
	UNION ALL
	SELECT id, target, source, reverse_cost FROM random_edges WHERE reverse_cost >= 0 AND source <> target;

statement ok
CREATE TABLE simple_paths AS
WITH RECURSIVE walk(nodes, edges, last, cost) AS (
	SELECT [0::BIGINT], []::BIGINT[], 0::BIGINT, 0::DOUBLE
	UNION ALL
	SELECT list_append(nodes, a.v), list_append(edges, a.id), a.v, cost + a.c
	FROM walk w JOIN arcs a ON a.u = w.last WHERE NOT list_contains(nodes, a.v) AND w.last <> 5
)
SELECT nodes, edges, cost FROM walk WHERE last = 5;

query I
SELECT count(*) > 20 FROM simple_paths;
----
true

statement ok
CREATE TABLE all_paths AS
SELECT path_id, list(node ORDER BY path_seq) AS nodes, list(edge ORDER BY path_seq) FILTER (edge <> -1) AS edges, max(agg_cost) AS cost
FROM pgr_KSP((SELECT * FROM random_edges), 0, 5, 100000) GROUP BY path_id;

query I
SELECT count(*) FROM (
	(SELECT nodes, edges, cost FROM simple_paths EXCEPT SELECT nodes, edges, cost FROM all_paths)
	UNION ALL
	(SELECT nodes, edges, cost FROM all_paths EXCEPT SELECT nodes, edges, cost FROM simple_paths));
----
0

query I
SELECT count(*) = (SELECT count(*) FROM simple_paths) FROM all_paths;
----
true

# The paths come by increasing cost, and the first K of them are the K cheapest
query I
SELECT count(*) FROM (SELECT cost, lag(cost) OVER (ORDER BY path_id) AS previous FROM all_paths) WHERE cost < previous;
----
0

query I
SELECT count(*) FROM (
	SELECT path_id, max(agg_cost) AS cost FROM pgr_KSP((SELECT * FROM random_edges), 0, 5, 7) GROUP BY path_id) k
FULL JOIN (SELECT * FROM all_paths WHERE path_id <= 7) a USING (path_id)
WHERE k.cost IS DISTINCT FROM a.cost;
----
0

# The first path is the shortest path
query I
SELECT count(*) FROM (
	SELECT path_seq, node, edge, cost, agg_cost FROM pgr_KSP((SELECT * FROM random_edges), 0, 5, 1)
	EXCEPT SELECT path_seq, node, edge, cost, agg_cost FROM pgr_dijkstra((SELECT * FROM random_edges), 0, 5));
----
0

query R
SELECT min(cost) = (SELECT agg_cost FROM pgr_dijkstraCost((SELECT * FROM random_edges), 0, 5)) FROM all_paths;
----
true

# With heap_paths the K shortest paths come first, followed by valid extra paths
query I
SELECT count(*) FROM (
	SELECT path_id, list(node ORDER BY path_seq) AS nodes, list(edge ORDER BY path_seq) FILTER (edge <> -1) AS edges, max(agg_cost) AS cost
	FROM pgr_KSP((SELECT * FROM random_edges), 0, 5, 3, heap_paths := true) GROUP BY path_id) h
WHERE (path_id <= 3 AND NOT EXISTS (SELECT 1 FROM all_paths a WHERE a.path_id = h.path_id AND a.cost = h.cost))
   OR NOT EXISTS (SELECT 1 FROM simple_paths s WHERE s.nodes = h.nodes AND s.edges = h.edges AND s.cost = h.cost);
----
0
