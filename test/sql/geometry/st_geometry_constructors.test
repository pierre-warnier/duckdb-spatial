# name: test/sql/geometry/st_geometry_constructors.test
# description: Test ST_ForceCollection, ST_Scroll, ST_QuantizeCoordinates, ST_MemSize, ST_Polygon, ST_LineFromMultiPoint
# group: [spatial]

require spatial

# ST_ForceCollection - point
query I
SELECT ST_AsText(ST_ForceCollection(ST_Point(1, 2)));
----
GEOMETRYCOLLECTION (POINT (1 2))

# ST_ForceCollection - linestring
query I
SELECT ST_GeometryType(ST_ForceCollection(ST_GeomFromText('LINESTRING(0 0, 1 1)')));
----
GEOMETRYCOLLECTION

# ST_ForceCollection - already a collection (no-op)
query I
SELECT ST_AsText(ST_ForceCollection(ST_GeomFromText('GEOMETRYCOLLECTION(POINT(1 2))')));
----
GEOMETRYCOLLECTION (POINT (1 2))

# ST_Scroll - rotate start to nearest point
query I
SELECT ST_AsText(ST_Scroll(ST_GeomFromText('LINESTRING(0 0, 1 0, 1 1, 0 1, 0 0)'), ST_Point(1, 1)));
----
LINESTRING (1 1, 0 1, 0 0, 1 0, 1 1)

# ST_Scroll - rotate to first point (no change)
query I
SELECT ST_AsText(ST_Scroll(ST_GeomFromText('LINESTRING(0 0, 1 0, 1 1, 0 1, 0 0)'), ST_Point(0, 0)));
----
LINESTRING (0 0, 1 0, 1 1, 0 1, 0 0)

# ST_Scroll - error on non-closed linestring
statement error
SELECT ST_Scroll(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2)'), ST_Point(1, 1));
----
ST_Scroll: linestring must be closed

# ST_QuantizeCoordinates - round to 2 decimal places
query I
SELECT ST_AsText(ST_QuantizeCoordinates(ST_Point(1.23456, 2.78901), 2));
----
POINT (1.23 2.79)

# ST_QuantizeCoordinates - round to 0 decimal places
query I
SELECT ST_AsText(ST_QuantizeCoordinates(ST_Point(1.6, 2.3), 0));
----
POINT (2 2)

# ST_QuantizeCoordinates - works on linestring
query I
SELECT ST_AsText(ST_QuantizeCoordinates(ST_GeomFromText('LINESTRING(1.111 2.222, 3.333 4.444)'), 1));
----
LINESTRING (1.1 2.2, 3.3 4.4)

# ST_MemSize - returns blob size
query I
SELECT ST_MemSize(ST_Point(1, 2)) > 0;
----
true

# ST_MemSize - bigger geometry is larger
query I
SELECT ST_MemSize(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2, 3 3)')) > ST_MemSize(ST_Point(1, 2));
----
true

# ST_Polygon - create polygon from closed linestring
query I
SELECT ST_AsText(ST_Polygon(ST_GeomFromText('LINESTRING(0 0, 1 0, 1 1, 0 1, 0 0)')));
----
POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))

# ST_Polygon - verify type
query I
SELECT ST_GeometryType(ST_Polygon(ST_GeomFromText('LINESTRING(0 0, 1 0, 1 1, 0 1, 0 0)')));
----
POLYGON

# ST_Polygon - error on non-closed linestring (too few points for closed ring)
statement error
SELECT ST_Polygon(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2)'));
----
ST_Polygon: linestring must have at least 4 points

# ST_Polygon - error on non-linestring
statement error
SELECT ST_Polygon(ST_Point(0, 0));
----
ST_Polygon: argument must be a closed LINESTRING

# ST_LineFromMultiPoint
query I
SELECT ST_AsText(ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT(0 0, 1 1, 2 2)')));
----
LINESTRING (0 0, 1 1, 2 2)

# ST_LineFromMultiPoint - verify type
query I
SELECT ST_GeometryType(ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT(0 0, 1 1)')));
----
LINESTRING

# ST_LineFromMultiPoint - error on non-multipoint
statement error
SELECT ST_LineFromMultiPoint(ST_Point(0, 0));
----
ST_LineFromMultiPoint: argument must be a MULTIPOINT

# ST_LineFromMultiPoint - error on single point
statement error
SELECT ST_LineFromMultiPoint(ST_GeomFromText('MULTIPOINT(0 0)'));
----
ST_LineFromMultiPoint: multipoint must have at least 2 points
