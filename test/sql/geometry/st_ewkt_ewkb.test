# name: test/sql/geometry/st_ewkt_ewkb.test
# description: EWKT and EWKB, as written by PostGIS, are read by ST_GeomFromText and ST_GeomFromWKB (the SRID is dropped)
# group: [spatial]

require spatial

query I
SELECT ST_AsText(ST_GeomFromText('SRID=4326;POINT(1 2)'));
----
POINT (1 2)

query I
SELECT ST_AsText(ST_GeomFromText('LINESTRING(0 0, 1 1, 2 2)'));
----
LINESTRING (0 0, 1 1, 2 2)

query I
SELECT ST_GeometryType(ST_GeomFromText('SRID=4326;POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))'));
----
POLYGON

query I
SELECT ST_AsText(ST_GeomFromText('srid=4326;POINT(5 6)'));
----
POINT (5 6)

statement error
SELECT ST_GeomFromText('SRID=4326;INVALID');
----
Invalid Input Error

# EWKB of POINT (1 2) with SRID 4326
query I
SELECT ST_AsText(ST_GeomFromWKB('\x01\x01\x00\x00\x20\xE6\x10\x00\x00\x00\x00\x00\x00\x00\x00\xF0\x3F\x00\x00\x00\x00\x00\x00\x00\x40'::BLOB));
----
POINT (1 2)

query I
SELECT ST_AsText(ST_GeomFromWKB(ST_AsWKB(ST_GeomFromText('POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))'))));
----
POLYGON ((0 0, 1 0, 1 1, 0 1, 0 0))
