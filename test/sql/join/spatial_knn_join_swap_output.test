# name: test/sql/join/spatial_knn_join_swap_output.test
# description: an ST_KNN join whose children the optimizer swaps keeps the column order its parents expect (issue #155)
# group: [join]

require spatial

statement ok
CREATE TABLE p AS SELECT range AS id, ST_Point(range, 0) AS geom FROM range(10);

statement ok
CREATE TABLE q AS SELECT 'n' || range AS nom, ST_Point(range + 0.1, 0) AS geom FROM range(10);

# The repro of #155: two KNN joins, one searched side is a projected subquery
query II
SELECT f.nom, j.nom
FROM (SELECT p.id, q.nom FROM p JOIN q ON ST_KNN(p.geom, q.geom, 1)) f
JOIN (SELECT p.id, q.nom FROM p JOIN (SELECT nom, ST_Translate(geom, 0, 0) AS geom FROM q) q ON ST_KNN(p.geom, q.geom, 1)) j
USING (id) ORDER BY f.nom;
----
n0	n0
n1	n1
n2	n2
n3	n3
n4	n4
n5	n5
n6	n6
n7	n7
n8	n8
n9	n9

query III
SELECT f.id, f.nom, j.nom
FROM (SELECT p.id, q.nom FROM p JOIN q ON ST_KNN(p.geom, q.geom, 1)) f
JOIN (SELECT p.id, q.nom FROM p JOIN (SELECT nom, ST_Translate(geom, 0, 0) AS geom FROM q) q ON ST_KNN(p.geom, q.geom, 1)) j
ON f.id = j.id ORDER BY f.id;
----
0	n0	n0
1	n1	n1
2	n2	n2
3	n3	n3
4	n4	n4
5	n5	n5
6	n6	n6
7	n7	n7
8	n8	n8
9	n9	n9

# Both orders of the tables in the FROM clause, columns of both sides, with a parent projection
query IIR
SELECT q2.nom, p.id, round(ST_Distance(p.geom, q2.geom), 3)
FROM (SELECT nom, ST_Translate(geom, 0, 0) AS geom FROM q) q2 JOIN p ON ST_KNN(p.geom, q2.geom, 1)
ORDER BY p.id LIMIT 3;
----
n0	0	0.1
n1	1	0.1
n2	2	0.1

# LEFT join: the probe rows without a match keep their place
query II
SELECT p.id, s.nom FROM p LEFT JOIN (SELECT nom, ST_Translate(geom, 0, 0) AS geom FROM q WHERE nom IN ('n0', 'n9')) s
  ON ST_KNN(p.geom, s.geom, 1) ORDER BY p.id;
----
0	n0
1	n0
2	n0
3	n0
4	n0
5	n9
6	n9
7	n9
8	n9
9	n9
